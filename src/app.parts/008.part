}

function GoalsPage({state,openModal,activeProfileId}) {
  const goals=state.goals.filter(x=>profileMatch(x,activeProfileId));
  return <div style={{display:"grid",gap:14}}><div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}><div><div style={{fontSize:18,fontWeight:950}}>Metas financeiras</div><div style={{fontSize:11,color:THEME.muted,marginTop:3}}>Acompanhar progresso, sem recomendação automática</div></div><Button onClick={()=>openModal("newGoal")}>+ Nova meta</Button></div><div className="card-grid">{goals.map(g=>{const pct=g.target?num(g.current)/num(g.target)*100:0;return <Card key={g.id}><CardBody><div style={{display:"flex",justifyContent:"space-between",gap:10}}><div><div style={{fontSize:14,fontWeight:950}}>{g.name}</div><div style={{fontSize:10,color:THEME.muted,marginTop:3}}>Prazo {g.deadline?new Date(`${g.deadline}T12:00:00`).toLocaleDateString("pt-BR"):"sem prazo"}</div></div><Badge tone={pct>=100?"income":"accent"}>{Math.min(100,pct).toFixed(0)}%</Badge></div><div style={{fontSize:23,fontWeight:950,marginTop:18}}>{money(g.current)} <span style={{fontSize:12,color:THEME.muted,fontWeight:700}}>/ {money(g.target)}</span></div><div style={{height:7,borderRadius:99,background:THEME.border,overflow:"hidden",marginTop:12}}><div style={{height:"100%",width:`${Math.min(100,pct)}%`,background:THEME.accent}}/></div><Button ghost style={{marginTop:13}} onClick={()=>openModal("goalContribution",g)}>Registrar aporte</Button></CardBody></Card>})}{goals.length===0&&<Card><Empty>Nenhuma meta criada.</Empty></Card>}</div></div>;
}

function CalendarPage({state,activeProfileId,ym,setYm}) {
  const [y,m]=ym.split("-").map(Number); const days=new Date(y,m,0).getDate(); const first=new Date(y,m-1,1).getDay();
  const byDate={}; const put=(date,item)=>{if(!date||!inMonth(date,ym))return;(byDate[date] ||= []).push(item);};
  state.receivables.filter(x=>profileMatch(x,activeProfileId)&&remaining(x)>0).forEach(x=>put(x.dueDate,{label:x.name,tone:"income",value:remaining(x)}));
  state.bills.filter(x=>profileMatch(x,activeProfileId)&&remaining(x)>0).forEach(x=>put(x.dueDate,{label:x.name,tone:"expense",value:remaining(x)}));
  state.cards.filter(x=>profileMatch(x,activeProfileId)).forEach(c=>{const open=Math.max(0,cardStatementAmount(state,c.id,ym)-cardStatementPaid(state,c.id,ym));if(open>0)put(statementDueDate(c,ym),{label:`Fatura ${c.name}`,tone:"cyan",value:open});});
  state.debts.filter(x=>profileMatch(x,activeProfileId)&&debtStatus(state,x)==="active").forEach(d=>{debtSchedule(state,d).filter(inst=>inMonth(inst.dueDate,ym)&&!debtInstallmentPayment(state,d.id,inst.number)).forEach(inst=>put(inst.dueDate,{label:`${d.name} • ${inst.number}/${debtSchedule(state,d).length}`,tone:"warning",value:inst.amount}));});
  const cells=[];for(let i=0;i<first;i++)cells.push(null);for(let d=1;d<=days;d++)cells.push(d);
  return <Card><SectionHeader title={`Calendário financeiro — ${monthName(ym)}`} sub="Contas, recebimentos, faturas e parcelas por data" action={<div style={{display:"flex",gap:6}}><Button ghost onClick={()=>setYm(shiftMonth(ym,-1))}>‹</Button><Button ghost onClick={()=>setYm(currentYM())}>Hoje</Button><Button ghost onClick={()=>setYm(shiftMonth(ym,1))}>›</Button></div>}/><CardBody><div className="calendar-head">{["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"].map(x=><div key={x}>{x}</div>)}</div><div className="calendar-grid">{cells.map((d,i)=>{if(!d)return <div key={`e${i}`} className="cal-cell empty-cell"/>;const date=`${ym}-${String(d).padStart(2,"0")}`,events=byDate[date]||[];return <div key={date} className="cal-cell"><div style={{display:"flex",justifyContent:"space-between"}}><b style={{fontSize:11,color:date===today()?THEME.accent:THEME.muted}}>{d}</b>{events.length>0&&<span style={{fontSize:9,color:THEME.subtle}}>{events.length}</span>}</div><div style={{display:"grid",gap:4,marginTop:7}}>{events.slice(0,3).map((e,idx)=><div key={idx} style={{fontSize:9.5,padding:"4px 5px",borderRadius:7,background:TONE(e.tone)+"12",color:TONE(e.tone),overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}} title={`${e.label} ${money(e.value)}`}>{e.label}</div>)}{events.length>3&&<div style={{fontSize:9,color:THEME.subtle}}>+{events.length-3}</div>}</div></div>})}</div></CardBody></Card>;
}

function ReportsPage({state,activeProfileId,ym}) {
  const metrics=buildMetrics(state,activeProfileId,ym,"month");
  function csvExport(){
    const rows=[["Tipo","Descrição","Data","Valor previsto","Realizado","Pendente","Perfil"]];
    metrics.receivables.forEach(x=>rows.push(["Recebimento",x.name,x.dueDate,x.amount,paidTotal(x),remaining(x),profileName(state,x.profileId)]));
    metrics.bills.forEach(x=>rows.push(["Conta",x.name,x.dueDate,x.amount,paidTotal(x),remaining(x),profileName(state,x.profileId)]));
    const csv=rows.map(r=>r.map(v=>`"${String(v??"").replace(/"/g,'""')}"`).join(";")).join("\n");
    const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=`financeiro-${ym}.csv`;a.click();URL.revokeObjectURL(url);
  }
  return <div style={{display:"grid",gap:14}}><div className="kpi-grid"><Kpi label="Receitas previstas" value={money(metrics.received+metrics.toReceive)} sub={`${money(metrics.received)} recebido`} tone="income"/><Kpi label="Compromissos" value={money(metrics.paid+metrics.toPay)} sub={`${money(metrics.toPay)} ainda a pagar`} tone="expense"/><Kpi label="Resultado do mês" value={money(metrics.resultProjected)} sub="Sem interpretação automática" tone={metrics.resultProjected>=0?"accent":"expense"}/><Kpi label="Saldo projetado" value={money(metrics.balanceProjected)} sub="Baseado no saldo informado" tone="cyan"/></div><Card><SectionHeader title="Exportação" sub="Os dados saem do sistema para análise externa"/><CardBody style={{display:"flex",gap:8,flexWrap:"wrap"}}><Button onClick={csvExport}>Exportar Excel/CSV</Button><Button ghost onClick={()=>window.print()}>Imprimir / Salvar PDF</Button></CardBody></Card><Card><SectionHeader title="Histórico do mês"/><div style={{overflowX:"auto"}}><table className="table"><thead><tr><th>Tipo</th><th>Descrição</th><th>Previsto</th><th>Realizado</th><th>Pendente</th></tr></thead><tbody>{[...metrics.receivables.map(x=>({kind:"Recebimento",...x})),...metrics.bills.map(x=>({kind:"Conta",...x}))].map(x=><tr key={`${x.kind}-${x.id}`}><td>{x.kind}</td><td><b>{x.name}</b></td><td>{money(x.amount)}</td><td>{money(paidTotal(x))}</td><td>{money(remaining(x))}</td></tr>)}</tbody></table></div></Card></div>;
}

function SettingsPage({state,setState,onBackup,onRestore,userEmail,onSignOut,syncStatus,lastSyncedAt,isOnline,onRetrySync}) {
  const [profile,setProfile]=useState(""); const [cat,setCat]=useState(""); const [catKind,setCatKind]=useState("expense"); const fileRef=useRef(null);
  function addProfile(){if(!profile.trim())return;setState(s=>({...s,profiles:[...s.profiles,{id:id("profile"),name:profile.trim(),type:"custom",color:THEME.accent,createdAt:new Date().toISOString()}]}));setProfile("");}
  function addCat(){if(!cat.trim())return;setState(s=>({...s,categories:[...s.categories,{id:id("cat"),name:cat.trim(),kind:catKind}]}));setCat("");}
  return <div style={{display:"grid",gap:14}}><div className="two-col"><Card><SectionHeader title="Perfis financeiros" sub="Pessoal, Casa, Empresa e visão consolidada"/><CardBody style={{display:"grid",gap:10}}>{state.profiles.map(p=><div key={p.id} style={{display:"flex",justifyContent:"space-between",padding:10,borderRadius:10,background:THEME.card2,border:`1px solid ${THEME.border}`}}><b style={{fontSize:12}}>{p.name}</b><Badge>Perfil</Badge></div>)}<div style={{display:"grid",gridTemplateColumns:"1fr auto",gap:8}}><Input value={profile} onChange={e=>setProfile(e.target.value)} placeholder="Novo perfil"/><Button onClick={addProfile}>Adicionar</Button></div></CardBody></Card><Card><SectionHeader title="Categorias" sub="Personalizáveis para receitas e gastos"/><CardBody style={{display:"grid",gap:10}}><div style={{display:"flex",gap:6,flexWrap:"wrap"}}>{state.categories.map(c=><Badge key={c.id} tone={c.kind==="income"?"income":c.kind==="expense"?"expense":"accent"}>{c.name}</Badge>)}</div><div style={{display:"grid",gridTemplateColumns:"1fr 120px auto",gap:8}}><Input value={cat} onChange={e=>setCat(e.target.value)} placeholder="Nova categoria"/><Select value={catKind} onChange={e=>setCatKind(e.target.value)}><option value="expense">Despesa</option><option value="income">Receita</option><option value="both">Ambos</option></Select><Button onClick={addCat}>Adicionar</Button></div></CardBody></Card></div><Card><SectionHeader title="Backup e restauração" sub="Backup completo do V7 em arquivo JSON"/><CardBody style={{display:"flex",gap:8,flexWrap:"wrap"}}><Button onClick={onBackup}>Baixar backup</Button><Button ghost onClick={()=>fileRef.current?.click()}>Restaurar backup</Button><input ref={fileRef} type="file" accept="application/json,.json" hidden onChange={e=>{const f=e.target.files?.[0];if(f)onRestore(f);e.target.value=""}}/></CardBody></Card><Card><SectionHeader title="Login e sincronização" sub="Supabase do Planner conectado"/><CardBody><div style={{display:"flex",justifyContent:"space-between",gap:14,alignItems:"center",flexWrap:"wrap"}}><div style={{display:"flex",gap:10,alignItems:"flex-start"}}><Badge tone={!isOnline?"warning":syncStatus==="error"?"expense":syncStatus==="saving"?"warning":"income"}>{!isOnline?"Offline":syncStatus==="saving"?"Salvando":syncStatus==="error"?"Erro":"Sincronizado"}</Badge><div><div style={{fontSize:12,fontWeight:850}}>{userEmail}</div><div style={{fontSize:10,color:THEME.muted,marginTop:3}}>{lastSyncedAt?`Última sincronização na nuvem: ${new Date(lastSyncedAt).toLocaleString("pt-BR")}`:"Ainda não houve sincronização confirmada."}</div><div style={{fontSize:10,color:THEME.subtle,marginTop:3}}>{isOnline?"Alterações são salvas automaticamente após alguns instantes.":"Alterações ficam salvas neste dispositivo e serão enviadas quando a conexão voltar."}</div></div></div><div style={{display:"flex",gap:8}}>{isOnline&&syncStatus==="error"&&<Button ghost tone="warning" onClick={onRetrySync}>Tentar novamente</Button>}<Button ghost tone="expense" onClick={onSignOut}>Sair da conta</Button></div></div></CardBody></Card></div>;
}

function SearchOverlay({state,term,setTerm,setTab}) {
  const q=term.trim().toLowerCase(); if(!q)return null;
  const active=state.activeProfileId;
  const results=[];
  state.receivables.filter(x=>profileMatch(x,active)).forEach(x=>{if(`${x.name} ${x.note||""} ${categoryName(state,x.categoryId)}`.toLowerCase().includes(q))results.push({tab:"receivables",kind:"Recebimento",name:x.name,meta:`${money(x.amount)} • ${x.dueDate}`});});
