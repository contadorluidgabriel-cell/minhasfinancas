  const firstOpen=schedule.find(x=>!debtInstallmentPayment(state,debt.id,x.number));
  return {...debt,installmentSchedule:schedule,installmentValue:firstOpen?num(firstOpen.amount):num(data.amount),firstDueDate:schedule[0]?.dueDate||debt.firstDueDate,totalInstallments:schedule.length};
}
function applyDebtAmortization(state,debt,event) {
  let schedule=debtSchedule(state,debt).map(x=>({...x}));
  const paidNumbers=new Set(state.debtEvents.filter(x=>x.debtId===debt.id&&x.kind==="installment").map(x=>num(x.installmentNumber)));
  const unpaid=schedule.filter(x=>!paidNumbers.has(num(x.number)));
  const amount=Math.max(0,num(event.actualAmount||event.amount));
  if(!unpaid.length||amount<=0)return debt;
  if(event.effect==="installment"){
    const outstanding=sum(unpaid,x=>x.amount);
    const newOutstanding=Math.max(0,outstanding-amount);
    if(newOutstanding<=0.005){
      schedule=schedule.filter(x=>paidNumbers.has(num(x.number)));
      return {...debt,installmentSchedule:schedule,totalInstallments:schedule.length,installmentValue:0,status:"settled"};
    }
    const per=newOutstanding/unpaid.length;
    schedule=schedule.map(x=>paidNumbers.has(num(x.number))?x:{...x,amount:Number(per.toFixed(2))});
    return {...debt,installmentSchedule:schedule,totalInstallments:schedule.length,installmentValue:Number(per.toFixed(2))};
  }
  let left=amount;
  for(let i=schedule.length-1;i>=0&&left>0.005;i--){
    const inst=schedule[i];
    if(paidNumbers.has(num(inst.number)))continue;
    const value=num(inst.amount);
    if(left>=value-0.005){ left-=value; schedule.splice(i,1); }
    else { schedule[i]={...inst,amount:Number(Math.max(0,value-left).toFixed(2))}; left=0; }
  }
  const remainingUnpaid=schedule.filter(x=>!paidNumbers.has(num(x.number)));
  return {...debt,installmentSchedule:schedule,totalInstallments:schedule.length,installmentValue:remainingUnpaid[0]?num(remainingUnpaid[0].amount):0,status:remainingUnpaid.length?debt.status:"settled"};
}

function TONE(tone) {
  return { accent:THEME.accent, income:THEME.income, expense:THEME.expense, warning:THEME.warning, muted:THEME.muted, cyan:THEME.cyan }[tone] || THEME.muted;
}

function Icon({name,size=18,stroke="currentColor",strokeWidth=1.8,style}) {
  const content={
    dashboard:<><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></>,
    receivables:<><path d="M7 5v10"/><path d="m3.5 11.5 3.5 3.5 3.5-3.5"/><path d="M13 7h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8"/></>,
    bills:<><path d="M17 19V9"/><path d="m20.5 12.5-3.5-3.5-3.5 3.5"/><path d="M11 17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11"/></>,
    card:<><rect x="2.5" y="5" width="19" height="14" rx="3"/><path d="M2.5 10h19"/><path d="M6 15h5"/></>,
    debt:<><circle cx="12" cy="12" r="9"/><path d="M15.2 8.7c-.7-.7-1.8-1.1-3.1-1.1-1.8 0-3.1.8-3.1 2.1 0 3.2 6.2 1.3 6.2 4.7 0 1.3-1.3 2.2-3.3 2.2-1.5 0-2.8-.5-3.7-1.4"/><path d="M12 6v12"/></>,
    balance:<><ellipse cx="12" cy="5.5" rx="7.5" ry="3"/><path d="M4.5 5.5v5c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-5"/><path d="M4.5 10.5v5c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-5"/></>,
    goal:<><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><path d="M12 3V1.8M21 12h1.2"/><path d="m17.8 6.2 2-2"/></>,
    calendar:<><rect x="3" y="5" width="18" height="16" rx="2.5"/><path d="M7 3v4M17 3v4M3 10h18"/><path d="M7 14h2M12 14h2M17 14h.1M7 18h2M12 18h2"/></>,
    reports:<><path d="M5 20V10M10 20V4M15 20v-7M20 20V7"/></>,
    settings:<><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21h-4v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H3v-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V3h4v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.1v4H21a1.7 1.7 0 0 0-1.6 1Z"/></>,
    search:<><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></>,
    down:<><path d="M12 4v13"/><path d="m7.5 12.5 4.5 4.5 4.5-4.5"/></>,
    up:<><path d="M12 20V7"/><path d="m7.5 11.5 4.5-4.5 4.5 4.5"/></>,
    wallet:<><path d="M4 7.5h14a2.5 2.5 0 0 1 2.5 2.5v8A2.5 2.5 0 0 1 18 20.5H5A2.5 2.5 0 0 1 2.5 18V6A2.5 2.5 0 0 1 5 3.5h11"/><path d="M15 12h5.5v4H15a2 2 0 0 1 0-4Z"/>,
    check:<><circle cx="12" cy="12" r="9"/><path d="m8 12.2 2.6 2.6 5.8-6"/></>,
    arrow:<><path d="M5 12h14"/><path d="m15 8 4 4-4 4"/></>,
    trend:<><path d="m3 17 5-5 4 3 7-8"/><path d="M15 7h4v4"/></>,
    menu:<><path d="M5 7h14M5 12h14M5 17h14"/></>,
    cloud:<><path d="M7.5 18H18a4 4 0 0 0 .5-8A6.5 6.5 0 0 0 6.2 8.2 4.8 4.8 0 0 0 7.5 18Z"/></>,
  }[name] || <circle cx="12" cy="12" r="2"/>;
  return <svg aria-hidden="true" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke={stroke} strokeWidth={strokeWidth} strokeLinecap="round" strokeLinejoin="round" style={{display:"block",...style}}>{content}</svg>;
}

function Sparkline({tone="accent"}) { const c=TONE(tone); return <svg viewBox="0 0 92 34" width="92" height="34" aria-hidden="true" style={{opacity:.9}}><defs><linearGradient id={`sg-${tone}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stopColor={c} stopOpacity=".20"/><stop offset="1" stopColor={c} stopOpacity="0"/></linearGradient></defs><path d="M2 29 C12 27,12 17,21 19 S31 25,38 15 S49 21,56 11 S68 18,76 9 S85 8,90 4 L90 34 L2 34Z" fill={`url(#sg-${tone})`}/><path d="M2 29 C12 27,12 17,21 19 S31 25,38 15 S49 21,56 11 S68 18,76 9 S85 8,90 4" fill="none" stroke={c} strokeWidth="1.8" strokeLinecap="round"/></svg>; }

function Button({children,onClick,tone="accent",ghost=false,disabled=false,type="button",style}) {
  const c=TONE(tone);
  const accentFill=tone==="accent"?`linear-gradient(135deg,${THEME.accent},${THEME.accent2})`:`linear-gradient(135deg,${c}24,${c}12)`;
  return <button className={`ui-button ${ghost?"ghost":"filled"}`} type={type} disabled={disabled} onClick={onClick} style={{border:`1px solid ${ghost?THEME.border:c+"55"}`,background:ghost?THEME.card2+"55":accentFill,color:ghost?THEME.text:tone==="accent"?"white":c,borderRadius:12,padding:"9px 13px",fontSize:12,fontWeight:850,cursor:disabled?"not-allowed":"pointer",opacity:disabled?.5:1,boxShadow:ghost?"none":tone==="accent"?`0 8px 22px ${THEME.accent}22`:"none",...style}}>{children}</button>;
}
function Field({label,children,hint}) { return <label style={{display:"grid",gap:7,fontSize:11,fontWeight:760,color:THEME.muted}}><span>{label}</span>{children}{hint&&<small style={{fontWeight:500,color:THEME.subtle,lineHeight:1.45}}>{hint}</small>}</label>; }
function Input(props) { return <input {...props} className={`ui-input ${props.className||""}`} style={{width:"100%",background:THEME.input,border:`1px solid ${THEME.border}`,borderRadius:12,color:THEME.text,padding:"10px 12px",fontSize:13,outline:"none",...(props.style||{})}}/>; }
function Select({children,...props}) { return <select {...props} className={`ui-input ${props.className||""}`} style={{width:"100%",background:THEME.input,border:`1px solid ${THEME.border}`,borderRadius:12,color:THEME.text,padding:"10px 12px",fontSize:13,outline:"none",...(props.style||{})}}>{children}</select>; }
function Textarea(props) { return <textarea {...props} className={`ui-input ${props.className||""}`} style={{width:"100%",minHeight:78,resize:"vertical",background:THEME.input,border:`1px solid ${THEME.border}`,borderRadius:12,color:THEME.text,padding:"10px 12px",fontSize:13,outline:"none",...(props.style||{})}}/>; }
function Card({children,style}) { return <section className="ui-card" style={{background:`linear-gradient(180deg,${THEME.card},${THEME.panel})`,border:`1px solid ${THEME.border}`,borderRadius:18,boxShadow:THEME.softShadow,...style}}>{children}</section>; }
function CardBody({children,style}) { return <div style={{padding:18,...style}}>{children}</div>; }
function SectionHeader({title,sub,action}) { return <div className="section-header" style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",gap:12,padding:"17px 18px",borderBottom:`1px solid ${THEME.border}`}}><div><div style={{fontSize:14,fontWeight:930,color:THEME.text,letterSpacing:-.15}}>{title}</div>{sub&&<div style={{fontSize:10.8,color:THEME.muted,marginTop:4,lineHeight:1.4}}>{sub}</div>}</div>{action}</div>; }
function Badge({children,tone="muted"}) { const c=TONE(tone); return <span style={{display:"inline-flex",alignItems:"center",gap:5,padding:"4px 8px",borderRadius:999,background:c+"12",border:`1px solid ${c}30`,color:c,fontSize:9.8,fontWeight:850,whiteSpace:"nowrap"}}>{children}</span>; }
function StatusBadge({item}) { const s=statusFromItem(item); if(s==="paid") return <Badge tone="income">Pago</Badge>; if(s==="partial") return <Badge tone="warning">Parcial</Badge>; if(s==="overdue") return <Badge tone="expense">Vencido</Badge>; return <Badge>Pendente</Badge>; }
function FlowStatusBadge({item,isRec}) { const s=statusFromItem(item); if(s==="paid") return <Badge tone="income">{isRec?"Recebido":"Pago"}</Badge>; if(s==="partial") return <Badge tone="warning">Parcial</Badge>; if(s==="overdue") return <Badge tone="expense">{isRec?"Atrasado":"Vencido"}</Badge>; return <Badge>Pendente</Badge>; }
function Empty({children="Nenhum registro por aqui.",icon="calendar"}) { return <div className="empty-state"><div className="empty-icon"><Icon name={icon} size={18}/></div><div>{children}</div></div>; }
function Kpi({label,value,sub,tone="accent",icon="trend"}) { const c=TONE(tone); return <Card style={{boxShadow:"none",position:"relative",overflow:"hidden"}}><CardBody style={{display:"flex",gap:13,alignItems:"center",padding:"16px 17px"}}><div className="kpi-icon" style={{width:40,height:40,flex:"0 0 40px",borderRadius:12,display:"grid",placeItems:"center",background:`linear-gradient(145deg,${c}18,${c}08)`,border:`1px solid ${c}24`,color:c}}><Icon name={icon} size={18}/></div><div style={{minWidth:0,flex:1}}><div style={{fontSize:9.4,textTransform:"uppercase",letterSpacing:.85,color:THEME.muted,fontWeight:820}}>{label}</div><div style={{fontSize:21,fontWeight:930,color:c,marginTop:4,fontVariantNumeric:"tabular-nums",letterSpacing:-.45}}>{value}</div><div style={{fontSize:10.1,color:THEME.subtle,marginTop:4,whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis"}}>{sub}</div></div><Icon name="arrow" size={15} stroke={THEME.subtle} style={{opacity:.55}}/></CardBody></Card>; }
function Modal({title,children,onClose,width=620}) { return <div onMouseDown={onClose} style={{position:"fixed",inset:0,zIndex:100,background:"rgba(2,6,12,.78)",backdropFilter:"blur(10px)",display:"grid",placeItems:"center",padding:16}}><div className="modal-card" onMouseDown={e=>e.stopPropagation()} style={{width:"100%",maxWidth:width,maxHeight:"92vh",overflowY:"auto",background:`linear-gradient(180deg,${THEME.card},${THEME.panel})`,border:`1px solid ${THEME.border}`,borderRadius:22,boxShadow:"0 34px 110px rgba(0,0,0,.55)"}}><div style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"17px 19px",borderBottom:`1px solid ${THEME.border}`}}><div style={{fontSize:15,fontWeight:930}}>{title}</div><button className="modal-close" onClick={onClose} style={{width:32,height:32,border:`1px solid ${THEME.border}`,borderRadius:10,background:THEME.card2,color:THEME.muted,fontSize:19,cursor:"pointer"}}>×</button></div><div style={{padding:19}}>{children}</div></div></div>; }

function categoryName(state,idValue) { return state.categories.find(x=>x.id===idValue)?.name || "Sem categoria"; }
function profileName(state,idValue) { return state.profiles.find(x=>x.id===idValue)?.name || "Perfil"; }

function buildMetrics(state, activeProfileId, ym, viewMode) {
  const receivables = scopedByView(state.receivables.filter(x=>profileMatch(x,activeProfileId)),ym,viewMode,"dueDate");
  const bills = scopedByView(state.bills.filter(x=>profileMatch(x,activeProfileId)),ym,viewMode,"dueDate");
  const scopedCards = state.cards.filter(x=>profileMatch(x,activeProfileId));
  const scopedDebts = state.debts.filter(x=>profileMatch(x,activeProfileId)&&debtStatus(state,x)!=="archived");

  const received = sum(receivables, paidTotal);
  const toReceive = sum(receivables, remaining);
  const billsPaid = sum(bills, paidTotal);
  const billsOpen = sum(bills, remaining);

  let cardExpected = 0, cardPaid = 0;
  scopedCards.forEach(card=>{
    if(viewMode==="month") {
      cardExpected += cardStatementAmount(state,card.id,ym);
      cardPaid += cardStatementPaid(state,card.id,ym);
    } else {
      const months=[ym,shiftMonth(ym,1)];
      months.forEach(m=>{
        const due=statementDueDate(card,m);
        if(inNext30(due)){ cardExpected += cardStatementAmount(state,card.id,m); cardPaid += cardStatementPaid(state,card.id,m); }
      });
    }
  });
  const cardOpen=Math.max(0,cardExpected-cardPaid);

  let debtExpected=0, debtPaid=0;
  scopedDebts.forEach(debt=>{
    if(viewMode==="month") {
      debtExpected += debtDueForMonth(state,debt,ym) + sum(debtEventsForMonth(state,debt.id,ym),e=>e.kind==="installment"?e.actualAmount||e.amount:0);
      debtPaid += sum(debtEventsForMonth(state,debt.id,ym),e=>e.kind==="installment"?e.actualAmount||e.amount:0);
    } else {
      debtExpected += debtDueNext30(state,debt);
      debtPaid += sum(state.debtEvents.filter(e=>e.debtId===debt.id&&inNext30(e.date)&&e.kind==="installment"),e=>e.actualAmount||e.amount);
    }
  });
  const debtOpen=Math.max(0,debtExpected-debtPaid);
  const paid = billsPaid + cardPaid + debtPaid;
  const toPay = billsOpen + cardOpen + debtOpen;
  const resultProjected = received + toReceive - paid - toPay;
  const accountSum=sum(state.accounts.filter(x=>profileMatch(x,activeProfileId)),x=>x.balance);
  const balanceCurrent = activeProfileId===PROFILE_ALL
    ? (state.balanceSnapshot.useAccountSum ? accountSum : num(state.balanceSnapshot.total))
    : (state.balanceSnapshot.useAccountSum ? accountSum : num(state.balanceSnapshot.total));
  const balanceProjected = balanceCurrent + toReceive - toPay;
  return { receivables,bills,received,toReceive,billsPaid,billsOpen,cardExpected,cardPaid,cardOpen,debtExpected,debtPaid,debtOpen,paid,toPay,resultProjected,balanceCurrent,balanceProjected };
}

function AppLogo() { return <div className="app-logo" style={{width:38,height:38,borderRadius:12,display:"grid",placeItems:"center",background:`linear-gradient(145deg,#6B8AFF,${THEME.accent2})`,boxShadow:`0 10px 28px ${THEME.accent}2A`,fontWeight:950,fontSize:18,color:"white",border:"1px solid rgba(255,255,255,.14)",letterSpacing:-1}}>F</div>; }

const NAV = [
  ["dashboard","Visão geral","dashboard"],
  ["receivables","Recebimentos","receivables"],
  ["bills","Contas a pagar","bills"],
  ["cards","Cartões","card"],
  ["debts","Dívidas e financiamentos","debt"],
  ["balances","Saldos","balance"],
  ["goals","Metas","goal"],
  ["calendar","Calendário","calendar"],
  ["reports","Histórico e relatórios","reports"],
  ["settings","Configurações","settings"],
];

function Sidebar({tab,setTab,open,setOpen,syncStatus,lastSyncedAt,isOnline}) {
  return <aside className={`sidebar ${open?"open":""}`} style={{background:`linear-gradient(180deg,${THEME.panel},#0A111C)`,borderRight:`1px solid ${THEME.border}`}}>
    <div className="brand-row" style={{display:"flex",alignItems:"center",gap:11,padding:"5px 8px 18px",borderBottom:`1px solid ${THEME.border}`,marginBottom:13}}><AppLogo/><div className="sidebar-copy"><div style={{fontSize:14,fontWeight:950,letterSpacing:-.2}}>Financeiro</div><div style={{fontSize:9.8,color:THEME.subtle,marginTop:2}}>Pessoal • V{APP_VERSION}</div></div></div>
    <nav style={{display:"grid",gap:4}}>{NAV.map(([key,label,icon])=><button className={`nav-item ${tab===key?"active":""}`} key={key} onClick={()=>{setTab(key);setOpen(false)}} style={{display:"flex",alignItems:"center",gap:11,width:"100%",border:`1px solid ${tab===key?THEME.accent+"28":"transparent"}`,borderRadius:12,padding:"10px 10px",background:tab===key?`linear-gradient(90deg,${THEME.accent}22,${THEME.accent}0D)`:"transparent",color:tab===key?THEME.text:THEME.muted,cursor:"pointer",fontSize:11.7,fontWeight:tab===key?850:650,textAlign:"left",position:"relative"}}><span className="nav-icon" style={{width:30,height:30,borderRadius:9,display:"grid",placeItems:"center",background:tab===key?THEME.accent+"13":"transparent",color:tab===key?THEME.accent:THEME.subtle}}><Icon name={icon} size={16}/></span><span className="sidebar-copy">{label}</span></button>)}</nav>
