  const [name,setName]=useState(""); const [amount,setAmount]=useState(""); const [dueDate,setDueDate]=useState(today()); const [categoryId,setCategoryId]=useState("cat-outros"); const [selectedProfileId,setSelectedProfileId]=useState(profileId); const [more,setMore]=useState(false); const [recurring,setRecurring]=useState(false); const [method,setMethod]=useState("");
  const cats=state.categories.filter(c=>c.kind===(kind==="receivable"?"income":"expense")||c.kind==="both");
  function submit(e){e.preventDefault();if(!name.trim()||num(amount)<=0||!selectedProfileId)return;onSave({profileId:selectedProfileId,name:name.trim(),amount:num(amount),dueDate,categoryId,method,recurring:false},recurring);}
  return <Modal title={title} onClose={onClose} width={580}><form onSubmit={submit} style={{display:"grid",gap:12}}><Field label={kind==="receivable"?"Quem vai pagar / origem":"Descrição"}><Input autoFocus value={name} onChange={e=>setName(e.target.value)} placeholder={kind==="receivable"?"Ex.: Cliente João":"Ex.: Energia"} required/></Field><div className="two-col-form"><Field label="Valor"><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal" placeholder="0,00" required/></Field><Field label={kind==="receivable"?"Data prevista":"Vencimento"}><Input type="date" value={dueDate} onChange={e=>setDueDate(e.target.value)} required/></Field></div><div className="two-col-form"><Field label="Categoria"><Select value={categoryId} onChange={e=>setCategoryId(e.target.value)}>{cats.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</Select></Field><Field label="Perfil"><Select value={selectedProfileId} onChange={e=>setSelectedProfileId(e.target.value)}>{state.profiles.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</Select></Field></div><button type="button" onClick={()=>setMore(v=>!v)} style={{justifySelf:"start",border:0,background:"transparent",color:THEME.accent,fontSize:11,fontWeight:850,cursor:"pointer",padding:"2px 0"}}>{more?"− Ocultar opções":"+ Mais opções"}</button>{more&&<div style={{display:"grid",gap:12,padding:12,borderRadius:13,background:THEME.card2,border:`1px solid ${THEME.border}`}}>{kind==="receivable"&&<Field label="Forma de recebimento"><Input value={method} onChange={e=>setMethod(e.target.value)} placeholder="Pix, transferência, dinheiro…"/></Field>}<label style={{display:"flex",gap:8,alignItems:"center",fontSize:12,color:THEME.text}}><input type="checkbox" checked={recurring} onChange={e=>setRecurring(e.target.checked)}/> Recorrente mensal</label></div>}<div style={{display:"flex",justifyContent:"flex-end",gap:8,paddingTop:2}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Salvar</Button></div></form></Modal>;
}

function FlowEditForm({state,item,kind,onClose,onSave}){
  const [name,setName]=useState(item.name||"");const [amount,setAmount]=useState(String(item.amount||""));const [dueDate,setDueDate]=useState(item.dueDate||today());const [categoryId,setCategoryId]=useState(item.categoryId||"cat-outros");const [profileId,setProfileId]=useState(item.profileId);const [method,setMethod]=useState(item.method||"");const [recurring,setRecurring]=useState(Boolean(item.recurring));const [scope,setScope]=useState(item.recurring&&item.seriesId?"current":"current");const cats=state.categories.filter(c=>c.kind===(kind==="receivable"?"income":"expense")||c.kind==="both");return <Modal title={`Editar • ${item.name}`} onClose={onClose} width={620}><form onSubmit={e=>{e.preventDefault();if(!name.trim()||num(amount)<=0)return;onSave({name:name.trim(),amount:num(amount),dueDate,categoryId,profileId,method,recurring},scope)}} style={{display:"grid",gap:12}}><Field label={kind==="receivable"?"Origem":"Descrição"}><Input value={name} onChange={e=>setName(e.target.value)} required/></Field><div className="two-col-form"><Field label="Valor"><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal"/></Field><Field label={kind==="receivable"?"Data prevista":"Vencimento"}><Input type="date" value={dueDate} onChange={e=>setDueDate(e.target.value)}/></Field></div><div className="two-col-form"><Field label="Categoria"><Select value={categoryId} onChange={e=>setCategoryId(e.target.value)}>{cats.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</Select></Field><Field label="Perfil"><Select value={profileId} onChange={e=>setProfileId(e.target.value)}>{state.profiles.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</Select></Field></div>{kind==="receivable"&&<Field label="Forma de recebimento"><Input value={method} onChange={e=>setMethod(e.target.value)}/></Field>}<label style={{display:"flex",gap:8,alignItems:"center",fontSize:12}}><input type="checkbox" checked={recurring} onChange={e=>setRecurring(e.target.checked)}/> Recorrente</label>{item.recurring&&item.seriesId&&<Field label="Aplicar alterações"><Select value={scope} onChange={e=>setScope(e.target.value)}><option value="current">Somente esta ocorrência</option><option value="future">Esta e as próximas</option></Select></Field>}<div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Salvar alterações</Button></div></form></Modal>;
}

function PaymentForm({title,max,onClose,onSave,label="Valor realmente pago/recebido"}) { const [amount,setAmount]=useState(String(max||"")); const [date,setDate]=useState(today()); const [method,setMethod]=useState(""); return <Modal title={title} onClose={onClose} width={500}><form onSubmit={e=>{e.preventDefault();const v=Math.min(num(amount),num(max));if(v<=0)return;onSave({amount:v,date,method})}} style={{display:"grid",gap:12}}><Field label={label} hint={`Pendente: ${money(max)}`}><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal"/></Field><div className="two-col-form"><Field label="Data"><Input type="date" value={date} onChange={e=>setDate(e.target.value)}/></Field><Field label="Forma"><Input value={method} onChange={e=>setMethod(e.target.value)} placeholder="Pix, boleto…"/></Field></div><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit" tone="income">Confirmar</Button></div></form></Modal>; }

function SettlementEditForm({item,payment,isRec,onClose,onSave}){const otherPaid=sum((item.payments||[]).filter(p=>p.id!==payment.id),p=>p.amount);const max=Math.max(0,num(item.amount)-otherPaid);const [amount,setAmount]=useState(String(payment.amount||""));const [date,setDate]=useState(payment.date||today());const [method,setMethod]=useState(payment.method||"");return <Modal title={`Corrigir baixa • ${item.name}`} onClose={onClose} width={500}><form onSubmit={e=>{e.preventDefault();const v=Math.min(num(amount),max);if(v<=0)return;onSave({amount:v,date,method})}} style={{display:"grid",gap:12}}><Field label={isRec?"Valor recebido":"Valor pago"} hint={`Máximo nesta baixa: ${money(max)}`}><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal"/></Field><div className="two-col-form"><Field label="Data"><Input type="date" value={date} onChange={e=>setDate(e.target.value)}/></Field><Field label="Forma"><Input value={method} onChange={e=>setMethod(e.target.value)}/></Field></div><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Salvar correção</Button></div></form></Modal>}

function CardForm({profileId,card,onClose,onSave}) { const [name,setName]=useState(card?.name||"");const [closingDay,setClosingDay]=useState(String(card?.closingDay||1));const [dueDay,setDueDay]=useState(String(card?.dueDay||10));const [limit,setLimit]=useState(String(card?.limit||""));return <Modal title={card?`Editar cartão • ${card.name}`:"Novo cartão"} onClose={onClose} width={500}><form onSubmit={e=>{e.preventDefault();if(!name.trim())return;onSave({name:name.trim(),closingDay:num(closingDay),dueDay:num(dueDay),limit:num(limit),profileId})}} style={{display:"grid",gap:12}}><Field label="Nome do cartão"><Input value={name} onChange={e=>setName(e.target.value)} required/></Field><div className="two-col-form"><Field label="Dia do fechamento"><Input type="number" min="1" max="31" value={closingDay} onChange={e=>setClosingDay(e.target.value)}/></Field><Field label="Dia do vencimento"><Input type="number" min="1" max="31" value={dueDay} onChange={e=>setDueDay(e.target.value)}/></Field></div><Field label="Limite total"><Input value={limit} onChange={e=>setLimit(e.target.value)} inputMode="decimal"/></Field><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Salvar</Button></div></form></Modal>; }

function CardPurchaseForm({state,profileId,initialCardId,onClose,onSave}) {
  const cards=state.cards.filter(c=>c.profileId===profileId&&c.active!==false); const [cardId,setCardId]=useState(initialCardId&&cards.some(c=>c.id===initialCardId)?initialCardId:cards[0]?.id||""); const [description,setDescription]=useState(""); const [total,setTotal]=useState(""); const [purchaseDate,setPurchaseDate]=useState(today()); const [purchaseType,setPurchaseType]=useState("normal"); const [installments,setInstallments]=useState("2"); const [categoryId,setCategoryId]=useState("cat-outros"); const expenseCats=state.categories.filter(c=>c.kind==="expense"||c.kind==="both"); const card=state.cards.find(c=>c.id===cardId); const autoMonth=card?automaticStatementMonth(card,purchaseDate):currentYM(); const [firstStatementMonth,setFirstStatementMonth]=useState(autoMonth); useEffect(()=>{setFirstStatementMonth(autoMonth)},[cardId,purchaseDate,autoMonth]); const invoiceOptions=[shiftMonth(autoMonth,-1),autoMonth,shiftMonth(autoMonth,1),shiftMonth(autoMonth,2)];
