  const debt=selectedDebtId?state.debts.find(x=>x.id===selectedDebtId):null;
  if(debt){
    const schedule=debtSchedule(state,debt); const next=debtNextInstallment(state,debt); const events=state.debtEvents.filter(x=>x.debtId===debt.id); const amortizations=events.filter(x=>x.kind==="amortization").sort((a,b)=>String(b.date).localeCompare(String(a.date))); const status=debtStatus(state,debt);
    return <div style={{display:"grid",gap:14}}>
      <div style={{display:"flex",justifyContent:"space-between",gap:10,alignItems:"center",flexWrap:"wrap"}}><div style={{display:"flex",gap:10,alignItems:"center"}}><Button ghost onClick={()=>setSelectedDebtId(null)}>← Voltar</Button><div><div style={{display:"flex",gap:8,alignItems:"center",flexWrap:"wrap"}}><div style={{fontSize:18,fontWeight:950}}>{debt.name}</div><Badge tone={status==="settled"?"income":status==="archived"?"muted":"warning"}>{debtStatusLabel(status)}</Badge></div><div style={{fontSize:11,color:THEME.muted,marginTop:3}}>{debtTypeLabel(debt.type)} • {debtFrequencyLabel(debt)}</div></div></div><div style={{display:"flex",gap:8,flexWrap:"wrap"}}><Button ghost onClick={()=>openModal("editDebt",debt)}>Editar</Button><Button ghost tone="expense" onClick={()=>openModal("manageDebt",debt)}>Excluir / arquivar</Button></div></div>
      <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>{[["summary","Resumo"],["installments","Parcelas"],["amortizations","Amortizações"]].map(([key,label])=><Button key={key} ghost={detailTab!==key} onClick={()=>setDetailTab(key)}>{label}</Button>)}</div>
      {detailTab==="summary"&&<Card><SectionHeader title="Resumo" sub="Controle interno do contrato; o saldo devedor do banco só muda quando você informar."/><CardBody><div className="card-summary-grid"><div><div className="metric-label">Valor contratado</div><div className="metric-value">{money(debt.contractValue)}</div></div><div><div className="metric-label">Valor da parcela</div><div className="metric-value">{debt.installmentValue?money(debt.installmentValue):"—"}</div></div><div><div className="metric-label">Total de parcelas</div><div className="metric-value">{schedule.length||"—"}</div></div><div><div className="metric-label">Vencimento</div><div className="metric-value">{next?.dueDate?new Date(`${next.dueDate}T12:00:00`).toLocaleDateString("pt-BR"):"—"}</div></div><div><div className="metric-label">Total já pago</div><div className="metric-value" style={{color:THEME.income}}>{money(debtTotalPaid(state,debt.id))}</div></div><div><div className="metric-label">Saldo devedor informado</div><div className="metric-value">{debt.bankOutstandingBalance===null||debt.bankOutstandingBalance===undefined?"Não informado":money(debt.bankOutstandingBalance)}</div></div></div></CardBody></Card>}
      {detailTab==="installments"&&<Card><SectionHeader title="Parcelas" sub="Lista simples do cronograma. Clique em uma parcela para pagar ou renegociar." action={next&&status==="active"?<Button tone="income" onClick={()=>openModal("payDebtInstallment",{debtId:debt.id,installmentNumber:next.number})}>Baixar próxima</Button>:null}/><div style={{overflowX:"auto"}}>{schedule.length===0?<Empty>Esta dívida não possui cronograma de parcelas definido.</Empty>:<table className="table"><thead><tr><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Status</th></tr></thead><tbody>{schedule.map(inst=>{const st=debtInstallmentStatus(state,debt,inst);return <tr key={`${debt.id}-${inst.number}`} className={st==="overdue"?"overdue-row":""} onClick={()=>openModal("debtInstallmentActions",{debtId:debt.id,installmentNumber:inst.number})} style={{cursor:"pointer"}}><td><b>{inst.number}</b></td><td>{new Date(`${inst.dueDate}T12:00:00`).toLocaleDateString("pt-BR")}</td><td style={{fontWeight:900}}>{money(inst.amount)}</td><td><Badge tone={st==="paid"?"income":st==="overdue"?"expense":"muted"}>{st==="paid"?"Paga":st==="overdue"?"Atrasada":"Pendente"}</Badge></td></tr>})}</tbody></table>}</div></Card>}
      {detailTab==="amortizations"&&<Card><SectionHeader title="Amortizações" sub="Ajustam o cronograma interno; não calculam automaticamente o saldo real da instituição." action={status==="active"?<Button onClick={()=>openModal("amortizeDebt",debt)}>+ Amortização</Button>:null}/><div style={{overflowX:"auto"}}>{amortizations.length===0?<Empty>Nenhuma amortização registrada.</Empty>:<table className="table"><thead><tr><th>Data</th><th>Valor</th><th>Efeito</th></tr></thead><tbody>{amortizations.map(e=><tr key={e.id}><td>{new Date(`${e.date}T12:00:00`).toLocaleDateString("pt-BR")}</td><td style={{fontWeight:900}}>{money(e.actualAmount||e.amount)}</td><td>{debtAmortizationEffectLabel(e.effect)}</td></tr>)}</tbody></table>}</div></Card>}
    </div>;
  }
  return <div style={{display:"grid",gap:14}}>
    <div style={{display:"flex",justifyContent:"space-between",gap:10,alignItems:"center",flexWrap:"wrap"}}><div><div style={{fontSize:18,fontWeight:950}}>Dívidas e financiamentos</div><div style={{fontSize:11,color:THEME.muted,marginTop:3}}>Cards enxutos para controle rápido; detalhes ficam dentro de cada dívida.</div></div><Button onClick={()=>openModal("newDebt")}>+ Nova dívida</Button></div>
    <Card><CardBody><div className="flow-filter-grid"><Field label="Status"><Select value={statusFilter} onChange={e=>setStatusFilter(e.target.value)}><option value="active">Ativas</option><option value="settled">Quitadas</option><option value="archived">Canceladas / arquivadas</option><option value="all">Todos</option></Select></Field><Field label="Tipo"><Select value={typeFilter} onChange={e=>setTypeFilter(e.target.value)}><option value="all">Todos</option><option value="financing">Financiamento</option><option value="loan">Empréstimo</option><option value="agreement">Acordo / renegociação</option><option value="informal">Dívida informal</option><option value="other">Outra</option></Select></Field><Field label="Perfil"><Select value={profileFilter} onChange={e=>setProfileFilter(e.target.value)}><option value="all">Todos</option>{state.profiles.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</Select></Field><Field label="Próximo vencimento"><Select value={dueFilter} onChange={e=>setDueFilter(e.target.value)}><option value="all">Todos</option><option value="overdue">Com atraso</option><option value="7d">Próximos 7 dias</option><option value="30d">Próximos 30 dias</option><option value="none">Sem vencimento</option></Select></Field><Field label="Parcela mínima"><Input value={minValue} onChange={e=>setMinValue(e.target.value)} inputMode="decimal" placeholder="0,00"/></Field><Field label="Parcela máxima"><Input value={maxValue} onChange={e=>setMaxValue(e.target.value)} inputMode="decimal" placeholder="0,00"/></Field></div><div style={{display:"flex",justifyContent:"flex-end",marginTop:10}}><Field label="Ordenar por"><Select value={sort} onChange={e=>setState(s=>({...s,settings:{...s.settings,debtSort:e.target.value}}))} style={{minWidth:210}}><option value="nextDueAsc">Vencimento mais próximo</option><option value="nextDueDesc">Vencimento mais distante</option><option value="name">Nome</option><option value="valueAsc">Menor parcela</option><option value="valueDesc">Maior parcela</option></Select></Field></div></CardBody></Card>
    <div className="card-grid">{visible.map(d=>{const next=debtNextInstallment(state,d),overdue=debtHasOverdue(state,d);return <Card key={d.id} style={{cursor:"pointer",...(overdue?{border:`1px solid ${THEME.expense}66`}:{})}}><CardBody style={{padding:16}}><div onClick={()=>{setSelectedDebtId(d.id);setDetailTab("summary")}}><div style={{display:"flex",justifyContent:"space-between",gap:8,alignItems:"flex-start"}}><div style={{fontSize:14,fontWeight:950}}>{d.name}</div>{overdue&&<Badge tone="expense">Parcela em atraso</Badge>}</div><div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginTop:18}}><div><div className="metric-label">Parcela</div><div className="metric-value">{next?money(next.amount):d.installmentValue?money(d.installmentValue):"Sem parcela fixa"}</div></div><div><div className="metric-label">Próximo vencimento</div><div className="metric-value">{next?.dueDate?new Date(`${next.dueDate}T12:00:00`).toLocaleDateString("pt-BR"):"—"}</div></div></div></div></CardBody></Card>})}{visible.length===0&&<Card><Empty>Nenhuma dívida encontrada com esses filtros.</Empty></Card>}</div>
  </div>;
}

function BalancesPage({state,setState,activeProfileId}) {
  const accounts=state.accounts.filter(x=>profileMatch(x,activeProfileId));
  const [name,setName]=useState(""); const [balance,setBalance]=useState("");
  const accountSum=sum(accounts,x=>x.balance);
  function add(){if(!name.trim())return;const profileId=activeProfileId===PROFILE_ALL?state.profiles[0].id:activeProfileId;setState(s=>({...s,accounts:[...s.accounts,{id:id("acc"),profileId,name:name.trim(),balance:num(balance),createdAt:new Date().toISOString()}]}));setName("");setBalance("");}
  function updateSnapshot(v){setState(s=>({...s,balanceSnapshot:{...s.balanceSnapshot,total:num(v),updatedAt:new Date().toISOString(),useAccountSum:false}}));}
  return <div style={{display:"grid",gap:14}}><div className="two-col"><Card><SectionHeader title="Saldo total informado" sub="Uma fotografia; não exige conciliar cada R$ 1"/><CardBody><div style={{fontSize:30,fontWeight:950,color:THEME.cyan}}>{money(state.balanceSnapshot.useAccountSum?accountSum:state.balanceSnapshot.total)}</div><div style={{fontSize:10,color:THEME.subtle,marginTop:4}}>Atualização: {state.balanceSnapshot.updatedAt?new Date(state.balanceSnapshot.updatedAt).toLocaleString("pt-BR"):"ainda não informado"}</div><div style={{display:"grid",gridTemplateColumns:"1fr auto",gap:8,marginTop:14}}><Input defaultValue={state.balanceSnapshot.total} onBlur={e=>updateSnapshot(e.target.value)} inputMode="decimal"/><Button ghost onClick={()=>setState(s=>({...s,balanceSnapshot:{...s.balanceSnapshot,total:accountSum,updatedAt:new Date().toISOString(),useAccountSum:true}}))}>Usar soma das contas</Button></div></CardBody></Card><Card><SectionHeader title="Adicionar conta opcional" sub="Detalhamento por banco quando fizer sentido"/><CardBody style={{display:"grid",gap:10}}><Input value={name} onChange={e=>setName(e.target.value)} placeholder="Ex.: Nubank"/><Input value={balance} onChange={e=>setBalance(e.target.value)} placeholder="Saldo" inputMode="decimal"/><Button onClick={add}>Adicionar conta</Button></CardBody></Card></div><Card><SectionHeader title="Contas cadastradas"/><CardBody style={{display:"grid",gap:8}}>{accounts.length===0?<Empty>Você pode usar apenas o saldo total, sem cadastrar bancos.</Empty>:accounts.map(a=><div key={a.id} style={{display:"flex",justifyContent:"space-between",gap:10,padding:12,borderRadius:12,background:THEME.card2,border:`1px solid ${THEME.border}`}}><div><b style={{fontSize:12}}>{a.name}</b><div className="subline">{profileName(state,a.profileId)}</div></div><div style={{fontWeight:900}}>{money(a.balance)}</div></div>)}</CardBody></Card></div>;
