  function submit(e){e.preventDefault();if(!name.trim()||!selectedProfileId)return;const data={profileId:selectedProfileId,name:name.trim(),type,contractValue:num(contractValue),installmentValue:useSchedule?num(installmentValue):0,totalInstallments:useSchedule?Math.max(0,Math.floor(num(totalInstallments))):0,firstDueDate:useSchedule?firstDueDate:"",frequency:useSchedule?frequency:"monthly",customFrequencyValue:Math.max(1,num(customFrequencyValue)||1),customFrequencyUnit,bankOutstandingBalance:bankOutstandingBalance===""?null:num(bankOutstandingBalance)};data.installmentSchedule=useSchedule?buildDebtSchedule(data):[];onSave(data);}
  return <Modal title={debt?`Editar • ${debt.name}`:"Nova dívida ou financiamento"} onClose={onClose} width={720}><form onSubmit={submit} style={{display:"grid",gap:12}}><div className="two-col-form"><Field label="Nome"><Input autoFocus value={name} onChange={e=>setName(e.target.value)} required/></Field><Field label="Tipo"><Select value={type} onChange={e=>setType(e.target.value)}><option value="financing">Financiamento</option><option value="loan">Empréstimo</option><option value="agreement">Acordo / renegociação</option><option value="informal">Dívida informal</option><option value="other">Outra dívida</option></Select></Field></div><div className="two-col-form"><Field label={contractLabel}><Input value={contractValue} onChange={e=>setContractValue(e.target.value)} inputMode="decimal" placeholder="0,00"/></Field><Field label="Perfil"><Select value={selectedProfileId} onChange={e=>setSelectedProfileId(e.target.value)}>{state.profiles.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</Select></Field></div>{!["informal","other"].includes(type)&&<Field label="Saldo devedor informado pela instituição" hint="Opcional e manual. O app não presume que o cronograma calculado é o saldo real do banco."><Input value={bankOutstandingBalance} onChange={e=>setBankOutstandingBalance(e.target.value)} inputMode="decimal" placeholder="Não informado"/></Field>}{["informal","other"].includes(type)&&<label style={{display:"flex",gap:8,alignItems:"center",fontSize:12,color:THEME.text}}><input type="checkbox" checked={hasSchedule} onChange={e=>setHasSchedule(e.target.checked)}/> Possui parcelas definidas</label>}{useSchedule&&<div style={{display:"grid",gap:12,padding:13,borderRadius:13,background:THEME.card2,border:`1px solid ${THEME.border}`}}><div className="two-col-form"><Field label="Valor da parcela"><Input value={installmentValue} onChange={e=>setInstallmentValue(e.target.value)} inputMode="decimal" required={scheduleMandatory}/></Field><Field label="Quantidade de parcelas"><Input type="number" min="1" value={totalInstallments} onChange={e=>setTotalInstallments(e.target.value)} required={scheduleMandatory}/></Field></div><div className="two-col-form"><Field label="Primeiro vencimento"><Input type="date" value={firstDueDate} onChange={e=>setFirstDueDate(e.target.value)} required={scheduleMandatory}/></Field><Field label="Frequência"><Select value={frequency} onChange={e=>setFrequency(e.target.value)}><option value="monthly">Mensal</option><option value="biweekly">Quinzenal</option><option value="weekly">Semanal</option><option value="bimonthly">Bimestral</option><option value="quarterly">Trimestral</option><option value="semiannual">Semestral</option><option value="annual">Anual</option><option value="custom">Personalizada</option></Select></Field></div>{frequency==="custom"&&<div className="two-col-form"><Field label="Intervalo"><Input type="number" min="1" value={customFrequencyValue} onChange={e=>setCustomFrequencyValue(e.target.value)}/></Field><Field label="Unidade"><Select value={customFrequencyUnit} onChange={e=>setCustomFrequencyUnit(e.target.value)}><option value="days">Dias</option><option value="months">Meses</option></Select></Field></div>}</div>}<div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">{debt?"Salvar alterações":"Salvar dívida"}</Button></div></form></Modal>;
}
function DebtInstallmentActionsModal({debt,installment,payment,onClose,onPay,onRenegotiate}) { const st=payment?"paid":installment.dueDate<today()?"overdue":"pending"; return <Modal title={`${debt.name} • parcela ${installment.number}`} onClose={onClose} width={500}><div style={{display:"grid",gap:12}}><div style={{padding:12,borderRadius:12,background:THEME.card2,border:`1px solid ${THEME.border}`,display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}><div><div className="metric-label">Vencimento</div><div className="metric-value">{new Date(`${installment.dueDate}T12:00:00`).toLocaleDateString("pt-BR")}</div></div><div><div className="metric-label">Valor</div><div className="metric-value">{money(installment.amount)}</div></div></div>{payment?<div style={{padding:12,borderRadius:12,background:THEME.income+"10",border:`1px solid ${THEME.income}33`,fontSize:11,lineHeight:1.6}}>Parcela paga em <b>{new Date(`${payment.date}T12:00:00`).toLocaleDateString("pt-BR")}</b> por <b>{money(payment.actualAmount)}</b>. Motivo da diferença: {debtReasonLabel(payment.reason)}.</div>:<><Button tone="income" onClick={onPay}>{st==="overdue"?"Baixar parcela atrasada":"Registrar pagamento"}</Button><Button ghost onClick={onRenegotiate}>Renegociar parcela</Button></>}<Button ghost onClick={onClose}>Fechar</Button></div></Modal>; }
function DebtInstallmentPaymentForm({debt,installment,onClose,onSave}) { const expected=num(installment.amount);const [actual,setActual]=useState(String(expected));const [date,setDate]=useState(today());const [reason,setReason]=useState("none");return <Modal title={`Baixar parcela ${installment.number} • ${debt.name}`} onClose={onClose} width={520}><form onSubmit={e=>{e.preventDefault();const v=num(actual);if(v<=0)return;if(Math.abs(v-expected)>.005&&reason==="none"){alert("Informe o motivo da diferença entre o valor previsto e o valor pago.");return;}onSave({kind:"installment",installmentNumber:installment.number,expectedAmount:expected,actualAmount:v,date,reason})}} style={{display:"grid",gap:12}}><div style={{padding:11,borderRadius:11,background:THEME.card2,border:`1px solid ${THEME.border}`,fontSize:11,color:THEME.muted}}>Valor previsto: <b style={{color:THEME.text}}>{money(expected)}</b> • vencimento {new Date(`${installment.dueDate}T12:00:00`).toLocaleDateString("pt-BR")}</div><Field label="Valor realmente pago"><Input value={actual} onChange={e=>setActual(e.target.value)} inputMode="decimal"/></Field><div className="two-col-form"><Field label="Data"><Input type="date" value={date} onChange={e=>setDate(e.target.value)}/></Field><Field label="Diferença / motivo"><Select value={reason} onChange={e=>setReason(e.target.value)}><option value="none">Sem diferença</option><option value="interest">Juros</option><option value="fine">Multa</option><option value="discount">Desconto</option><option value="amortization">Amortização</option><option value="other">Outro</option></Select></Field></div><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit" tone="income">Confirmar baixa</Button></div></form></Modal>; }
function DebtInstallmentEditForm({debt,installment,onClose,onSave}) { const [amount,setAmount]=useState(String(installment.amount));const [dueDate,setDueDate]=useState(installment.dueDate);const [scope,setScope]=useState("current");return <Modal title={`Renegociar parcela ${installment.number} • ${debt.name}`} onClose={onClose} width={540}><form onSubmit={e=>{e.preventDefault();if(num(amount)<=0||!dueDate)return;onSave({amount:num(amount),dueDate},scope)}} style={{display:"grid",gap:12}}><div className="two-col-form"><Field label="Novo valor"><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal"/></Field><Field label="Novo vencimento"><Input type="date" value={dueDate} onChange={e=>setDueDate(e.target.value)}/></Field></div><Field label="Aplicar alteração"><Select value={scope} onChange={e=>setScope(e.target.value)}><option value="current">Somente esta parcela</option><option value="future">Esta e todas as próximas</option></Select></Field><div style={{fontSize:10,color:THEME.subtle}}>Ao aplicar às próximas, o app mantém a frequência cadastrada e recria os vencimentos a partir desta data.</div><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Salvar renegociação</Button></div></form></Modal>; }
function DebtAmortizationForm({debt,onClose,onSave}) { const [actual,setActual]=useState("");const [date,setDate]=useState(today());const [effect,setEffect]=useState("term");return <Modal title={`Amortizar • ${debt.name}`} onClose={onClose} width={520}><form onSubmit={e=>{e.preventDefault();const v=num(actual);if(v<=0)return;onSave({kind:"amortization",actualAmount:v,date,effect})}} style={{display:"grid",gap:12}}><Field label="Valor amortizado"><Input value={actual} onChange={e=>setActual(e.target.value)} inputMode="decimal"/></Field><div className="two-col-form"><Field label="Data"><Input type="date" value={date} onChange={e=>setDate(e.target.value)}/></Field><Field label="Efeito da amortização"><Select value={effect} onChange={e=>setEffect(e.target.value)}><option value="term">Reduzir prazo</option><option value="installment">Reduzir valor das parcelas</option></Select></Field></div><div style={{fontSize:10,color:THEME.subtle,lineHeight:1.5}}>O app ajustará o cronograma interno automaticamente. O saldo devedor real da instituição continua sendo um dado manual.</div><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Registrar amortização</Button></div></form></Modal>; }
function ManageDebtModal({debt,status,onClose,onArchive,onReactivate,onSettle,onDelete}) { return <Modal title={`Gerenciar • ${debt.name}`} onClose={onClose} width={500}><div style={{display:"grid",gap:10}}><div style={{padding:12,borderRadius:12,background:THEME.card2,border:`1px solid ${THEME.border}`,fontSize:11,lineHeight:1.55}}>Status atual: <b>{debtStatusLabel(status)}</b>. Cancelar/arquivar mantém o histórico e tira a dívida da lista principal.</div>{status==="archived"?<Button onClick={onReactivate}>Reativar dívida</Button>:<Button ghost onClick={onArchive}>Cancelar / arquivar</Button>}{status==="active"&&<Button ghost tone="income" onClick={onSettle}>Marcar como quitada</Button>}<Button ghost tone="expense" onClick={onDelete}>Excluir definitivamente</Button><Button ghost onClick={onClose}>Fechar</Button></div></Modal>; }
