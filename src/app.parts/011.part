  function submit(e){e.preventDefault();const selectedCard=state.cards.find(c=>c.id===cardId),value=num(total);if(!selectedCard||!description.trim()||value<=0)return;const group=id("purchase");const arr=[];if(purchaseType==="subscription"){const count=Math.max(6,num(state.settings.recurrenceMonths)||18);for(let i=0;i<count;i++)arr.push({id:id("ci"),purchaseGroupId:group,subscriptionSeriesId:group,profileId,cardId,description:description.trim(),purchaseDate,purchaseType,categoryId,totalValue:value,installments:1,installmentNumber:1,statementMonth:shiftMonth(firstStatementMonth,i),amount:value,status:"active",createdAt:new Date().toISOString()});}else if(purchaseType==="installment"){const count=Math.max(2,num(installments));const each=Math.round((value/count)*100)/100;for(let i=0;i<count;i++){const amount=i===count-1?Math.round((value-each*(count-1))*100)/100:each;arr.push({id:id("ci"),purchaseGroupId:group,profileId,cardId,description:description.trim(),purchaseDate,purchaseType,categoryId,totalValue:value,installments:count,installmentNumber:i+1,statementMonth:shiftMonth(firstStatementMonth,i),amount,status:"active",createdAt:new Date().toISOString()});}}else arr.push({id:id("ci"),purchaseGroupId:group,profileId,cardId,description:description.trim(),purchaseDate,purchaseType,categoryId,totalValue:value,installments:1,installmentNumber:1,statementMonth:firstStatementMonth,amount:value,status:"active",createdAt:new Date().toISOString()});onSave(arr);}
  return <Modal title="Nova compra no cartão" onClose={onClose}><form onSubmit={submit} style={{display:"grid",gap:12}}>{cards.length===0?<Empty>Cadastre ou reative um cartão antes de lançar compras.</Empty>:<><div className="two-col-form"><Field label="Cartão"><Select value={cardId} onChange={e=>setCardId(e.target.value)}>{cards.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</Select></Field><Field label="Tipo"><Select value={purchaseType} onChange={e=>setPurchaseType(e.target.value)}><option value="normal">Compra normal</option><option value="subscription">Assinatura/recorrência</option><option value="installment">Compra parcelada</option><option value="fee">Tarifa/encargo/saque</option></Select></Field></div><Field label="Descrição"><Input value={description} onChange={e=>setDescription(e.target.value)} required/></Field><div className="two-col-form"><Field label={purchaseType==="subscription"?"Valor mensal":"Valor total"}><Input value={total} onChange={e=>setTotal(e.target.value)} inputMode="decimal" required/></Field><Field label="Data da compra"><Input type="date" value={purchaseDate} onChange={e=>setPurchaseDate(e.target.value)}/></Field></div>{purchaseType==="installment"&&<Field label="Quantidade de parcelas"><Input type="number" min="2" max="60" value={installments} onChange={e=>setInstallments(e.target.value)}/></Field>}<Field label="Fatura inicial (confirmar)" hint={`Sugestão pelo fechamento: ${monthName(autoMonth)}`}><Select value={firstStatementMonth} onChange={e=>setFirstStatementMonth(e.target.value)}>{[...new Set(invoiceOptions)].map(m=><option key={m} value={m}>{monthName(m)}</option>)}</Select></Field><Field label="Categoria"><Select value={categoryId} onChange={e=>setCategoryId(e.target.value)}>{expenseCats.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</Select></Field>{purchaseDate<today()&&<div style={{padding:10,borderRadius:10,background:THEME.warning+"12",border:`1px solid ${THEME.warning}33`,fontSize:10.5,color:THEME.warning}}>Compra lançada com data anterior: confirme acima a fatura correta.</div>}<div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit" tone="cyan">Salvar compra</Button></div></>}</form></Modal>;
}

function CardPurchaseEditForm({state,installment,onClose,onSave}){const [description,setDescription]=useState(installment.description||"");const [amount,setAmount]=useState(String(installment.amount||""));const [purchaseDate,setPurchaseDate]=useState(installment.purchaseDate||today());const [categoryId,setCategoryId]=useState(installment.categoryId||"cat-outros");const [statementMonth,setStatementMonth]=useState(installment.statementMonth||currentYM());const cats=state.categories.filter(c=>c.kind==="expense"||c.kind==="both");const months=[shiftMonth(statementMonth,-2),shiftMonth(statementMonth,-1),statementMonth,shiftMonth(statementMonth,1),shiftMonth(statementMonth,2)];return <Modal title={`Editar compra • ${installment.description}`} onClose={onClose} width={560}><form onSubmit={e=>{e.preventDefault();if(!description.trim()||num(amount)<=0)return;onSave({description:description.trim(),amount:num(amount),purchaseDate,categoryId,statementMonth})}} style={{display:"grid",gap:12}}><Field label="Descrição"><Input value={description} onChange={e=>setDescription(e.target.value)}/></Field><div className="two-col-form"><Field label="Valor desta cobrança"><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal"/></Field><Field label="Data da compra"><Input type="date" value={purchaseDate} onChange={e=>setPurchaseDate(e.target.value)}/></Field></div><div className="two-col-form"><Field label="Categoria"><Select value={categoryId} onChange={e=>setCategoryId(e.target.value)}>{cats.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</Select></Field><Field label="Fatura"><Select value={statementMonth} onChange={e=>setStatementMonth(e.target.value)}>{[...new Set(months)].sort().map(m=><option key={m} value={m}>{monthName(m)}</option>)}</Select></Field></div><div style={{fontSize:10,color:THEME.subtle}}>Faturas fechadas continuam editáveis. Alterar a fatura move esta cobrança para o mês escolhido.</div><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit">Salvar</Button></div></form></Modal>}

function CardPaymentForm({card,ym,open,onClose,onSave}){const [amount,setAmount]=useState(String(open));const [date,setDate]=useState(today());return <Modal title={`Pagar fatura • ${card.name}`} onClose={onClose} width={500}><form onSubmit={e=>{e.preventDefault();const v=Math.min(num(amount),num(open));if(v<=0)return;onSave({amount:v,date})}} style={{display:"grid",gap:12}}><div style={{padding:12,borderRadius:12,background:THEME.card2,border:`1px solid ${THEME.border}`}}><div className="metric-label">Fatura em aberto • {monthName(ym)}</div><div style={{fontSize:22,fontWeight:950,marginTop:5}}>{money(open)}</div></div><Field label="Valor do pagamento" hint="Use o valor total para quitar ou informe um valor menor para pagamento parcial."><Input value={amount} onChange={e=>setAmount(e.target.value)} inputMode="decimal"/></Field><Field label="Data"><Input type="date" value={date} onChange={e=>setDate(e.target.value)}/></Field><div style={{display:"flex",gap:8,justifyContent:"space-between",flexWrap:"wrap"}}><Button ghost onClick={()=>setAmount(String(open))}>Preencher quitação total</Button><div style={{display:"flex",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button type="submit" tone="income">Registrar pagamento</Button></div></div></form></Modal>}

function CardLimitForm({state,card,onClose,onSave}){const calculated=Math.max(0,num(card.limit)-cardCommittedAmount(state,card.id));const [value,setValue]=useState(card.availableLimitOverride===null||card.availableLimitOverride===undefined?"":String(card.availableLimitOverride));return <Modal title={`Ajustar limite • ${card.name}`} onClose={onClose} width={500}><div style={{display:"grid",gap:12}}><div style={{padding:12,borderRadius:12,background:THEME.card2,border:`1px solid ${THEME.border}`,fontSize:11}}>Limite disponível calculado: <b>{money(calculated)}</b></div><Field label="Limite disponível informado pelo banco" hint="Deixe vazio para voltar ao cálculo automático."><Input value={value} onChange={e=>setValue(e.target.value)} inputMode="decimal" placeholder="Automático"/></Field><div style={{display:"flex",justifyContent:"flex-end",gap:8}}><Button ghost onClick={onClose}>Cancelar</Button><Button onClick={()=>onSave(value===""?null:num(value))}>Salvar ajuste</Button></div></div></Modal>}

function ManageCardModal({card,onClose,onToggle,onDelete}){return <Modal title={`Cartão • ${card.name}`} onClose={onClose} width={500}><div style={{display:"grid",gap:12}}><div style={{padding:12,borderRadius:12,background:THEME.card2,border:`1px solid ${THEME.border}`,fontSize:11,lineHeight:1.55}}>Você pode manter todo o histórico e apenas <b>{card.active===false?"reativar":"marcar como inativo"}</b>, ou excluir o cartão definitivamente junto com compras e pagamentos.</div><Button onClick={onToggle}>{card.active===false?"Reativar cartão":"Marcar como inativo"}</Button><Button ghost tone="expense" onClick={onDelete}>Excluir cartão definitivamente</Button><Button ghost onClick={onClose}>Cancelar</Button></div></Modal>}

function DebtForm({state,debt=null,profileId,onClose,onSave}) {
  const [name,setName]=useState(debt?.name||""); const [type,setType]=useState(debt?.type||"financing"); const [selectedProfileId,setSelectedProfileId]=useState(debt?.profileId||profileId);
  const [contractValue,setContractValue]=useState(debt?.contractValue?String(debt.contractValue):""); const [installmentValue,setInstallmentValue]=useState(debt?.installmentValue?String(debt.installmentValue):""); const [totalInstallments,setTotalInstallments]=useState(debt?.totalInstallments?String(debt.totalInstallments):""); const [firstDueDate,setFirstDueDate]=useState(debt?.firstDueDate||today());
  const [frequency,setFrequency]=useState(debt?.frequency||"monthly"); const [customFrequencyValue,setCustomFrequencyValue]=useState(String(debt?.customFrequencyValue||1)); const [customFrequencyUnit,setCustomFrequencyUnit]=useState(debt?.customFrequencyUnit||"days"); const [bankOutstandingBalance,setBankOutstandingBalance]=useState(debt?.bankOutstandingBalance===null||debt?.bankOutstandingBalance===undefined?"":String(debt.bankOutstandingBalance));
  const defaultHasSchedule=debt?debtSchedule(state,debt).length>0:!["informal","other"].includes(type); const [hasSchedule,setHasSchedule]=useState(defaultHasSchedule);
  const scheduleMandatory=!["informal","other"].includes(type); const useSchedule=scheduleMandatory||hasSchedule;
  const contractLabel={financing:"Valor financiado",loan:"Valor do empréstimo",agreement:"Valor negociado",informal:"Valor da dívida",other:"Valor contratado"}[type]||"Valor contratado";
