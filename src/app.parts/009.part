  state.bills.filter(x=>profileMatch(x,active)).forEach(x=>{if(`${x.name} ${x.note||""} ${categoryName(state,x.categoryId)}`.toLowerCase().includes(q))results.push({tab:"bills",kind:"Conta",name:x.name,meta:`${money(x.amount)} • ${x.dueDate}`});});
  state.cards.filter(x=>profileMatch(x,active)).forEach(x=>{if(x.name.toLowerCase().includes(q))results.push({tab:"cards",kind:"Cartão",name:x.name,meta:`Vence dia ${x.dueDay}`});});
  state.debts.filter(x=>profileMatch(x,active)).forEach(x=>{if(`${x.name} ${x.note||""}`.toLowerCase().includes(q))results.push({tab:"debts",kind:"Dívida",name:x.name,meta:`Parcela ${money(x.installmentValue)}`});});
  state.goals.filter(x=>profileMatch(x,active)).forEach(x=>{if(x.name.toLowerCase().includes(q))results.push({tab:"goals",kind:"Meta",name:x.name,meta:`${money(x.current)} / ${money(x.target)}`});});
  return <div style={{position:"fixed",zIndex:90,top:62,right:165,width:360,maxWidth:"calc(100vw - 24px)",background:THEME.panel,border:`1px solid ${THEME.border}`,borderRadius:16,boxShadow:"0 25px 80px rgba(0,0,0,.45)",overflow:"hidden"}}><div style={{padding:"11px 13px",fontSize:10,fontWeight:850,color:THEME.muted,borderBottom:`1px solid ${THEME.border}`}}>BUSCA GLOBAL • {results.length} resultado(s)</div><div style={{maxHeight:420,overflowY:"auto"}}>{results.length===0?<Empty>Nada encontrado.</Empty>:results.slice(0,20).map((r,i)=><button key={i} onClick={()=>{setTab(r.tab);setTerm("")}} style={{display:"block",width:"100%",textAlign:"left",padding:"11px 13px",border:0,borderBottom:`1px solid ${THEME.border}`,background:"transparent",color:THEME.text,cursor:"pointer"}}><div style={{fontSize:11,fontWeight:900}}>{r.name}</div><div style={{fontSize:9.5,color:THEME.subtle,marginTop:3}}>{r.kind} • {r.meta}</div></button>)}</div></div>;
}

function AppModal({modal,setModal,state,setState}) {
  if(!modal)return null;
  const close=()=>setModal(null); const profileId=state.activeProfileId===PROFILE_ALL?state.profiles[0]?.id:state.activeProfileId;
  if(modal.type==="newReceivable"||modal.type==="newBill") {
    const isRec=modal.type==="newReceivable"; return <EntryForm key={modal.type} title={isRec?"Novo recebimento":"Nova conta"} kind={isRec?"receivable":"bill"} state={state} profileId={profileId} onClose={close} onSave={(data,recurring)=>{setState(s=>{const count=Math.max(1,num(s.settings.recurrenceMonths)||18);const records=recurring?generateSeries(data,count,isRec?"receivable":"bill"):[{...data,id:id(isRec?"rec":"bill"),payments:[],createdAt:new Date().toISOString()}];return {...s,[isRec?"receivables":"bills"]:[...s[isRec?"receivables":"bills"],...records]};});close();}}/>;
  }
  if(modal.type==="payReceivable"||modal.type==="payBill") {
    const collection=modal.type==="payReceivable"?"receivables":"bills"; const item=modal.payload || state[collection].filter(x=>profileMatch(x,state.activeProfileId)&&remaining(x)>0).sort((a,b)=>String(a.dueDate).localeCompare(String(b.dueDate)))[0]; if(!item)return <Modal title="Baixa" onClose={close}><Empty>Nenhum item pendente.</Empty></Modal>;
    return <PaymentForm title={modal.type==="payReceivable"?`Recebimento parcial • ${item.name}`:`Pagamento parcial • ${item.name}`} max={remaining(item)} onClose={close} onSave={p=>{setState(s=>({...s,[collection]:s[collection].map(x=>x.id===item.id?{...x,payments:[...(x.payments||[]),{id:id("pay"),...p}]}:x)}));close();}}/>;
  }
  if(modal.type==="editSettlement") {
    const {collection,itemId,paymentId,isRec}=modal.payload; const item=state[collection].find(x=>x.id===itemId); const payment=item?.payments?.find(p=>p.id===paymentId); if(!item||!payment)return null;
    return <SettlementEditForm item={item} payment={payment} isRec={isRec} onClose={close} onSave={data=>{setState(s=>({...s,[collection]:s[collection].map(x=>x.id===itemId?{...x,payments:(x.payments||[]).map(p=>p.id===paymentId?{...p,...data}:p)}:x)}));close();}}/>;
  }
  if(modal.type==="editFlow") {
    const {collection,item,isRec}=modal.payload;
    return <FlowEditForm state={state} item={item} kind={isRec?"receivable":"bill"} onClose={close} onSave={(data,scope)=>{setState(s=>{const current=s[collection].find(x=>x.id===item.id);if(!current)return s;if(scope!=="future"||!current.seriesId)return {...s,[collection]:s[collection].map(x=>x.id===item.id?{...x,...data}:x)};const baseIndex=num(current.seriesIndex);return {...s,[collection]:s[collection].map(x=>{if(x.seriesId!==current.seriesId||num(x.seriesIndex)<baseIndex)return x;const delta=num(x.seriesIndex)-baseIndex;return {...x,name:data.name,amount:data.amount,categoryId:data.categoryId,profileId:data.profileId,method:data.method||"",recurring:data.recurring,dueDate:addMonthsToDate(data.dueDate,delta)};})};});close();}}/>;
  }
  if(modal.type==="newCard") return <CardForm profileId={profileId} onClose={close} onSave={data=>{setState(s=>({...s,cards:[...s.cards,{...data,id:id("card"),profileId,active:true,availableLimitOverride:null,createdAt:new Date().toISOString()}]}));close();}}/>;
  if(modal.type==="editCard") {const card=modal.payload;return <CardForm card={card} profileId={card.profileId} onClose={close} onSave={data=>{setState(s=>({...s,cards:s.cards.map(x=>x.id===card.id?{...x,...data}:x)}));close();}}/>;}
  if(modal.type==="newCardPurchase") return <CardPurchaseForm state={state} profileId={profileId} initialCardId={modal.payload?.cardId||""} onClose={close} onSave={installments=>{setState(s=>({...s,cardInstallments:[...s.cardInstallments,...installments]}));close();}}/>;
  if(modal.type==="editCardPurchase") {const inst=modal.payload;return <CardPurchaseEditForm state={state} installment={inst} onClose={close} onSave={data=>{setState(s=>({...s,cardInstallments:s.cardInstallments.map(x=>x.id===inst.id?{...x,...data}:x)}));close();}}/>;}
  if(modal.type==="payCard") {const {card,ym,open}=modal.payload;return <CardPaymentForm card={card} ym={ym} open={open} onClose={close} onSave={p=>{setState(s=>({...s,cardPayments:[...s.cardPayments,{id:id("cardpay"),cardId:card.id,statementMonth:ym,amount:p.amount,date:p.date}]}));close();}}/>;}
  if(modal.type==="adjustCardLimit") {const card=modal.payload;return <CardLimitForm state={state} card={card} onClose={close} onSave={value=>{setState(s=>({...s,cards:s.cards.map(x=>x.id===card.id?{...x,availableLimitOverride:value}:x)}));close();}}/>;}
  if(modal.type==="manageCard") {const card=modal.payload;return <ManageCardModal card={card} onClose={close} onToggle={()=>{setState(s=>({...s,cards:s.cards.map(x=>x.id===card.id?{...x,active:x.active===false?true:false}:x)}));close();}} onDelete={()=>{if(!window.confirm(`Excluir “${card.name}” e todo o histórico deste cartão? Esta ação é definitiva.`))return;setState(s=>({...s,cards:s.cards.filter(x=>x.id!==card.id),cardInstallments:s.cardInstallments.filter(x=>x.cardId!==card.id),cardPayments:s.cardPayments.filter(x=>x.cardId!==card.id)}));close();}}/>;}
  if(modal.type==="newDebt") return <DebtForm state={state} profileId={profileId} onClose={close} onSave={data=>{setState(s=>({...s,debts:[...s.debts,{...data,id:id("debt"),status:"active",createdAt:new Date().toISOString()}]}));close();}}/>;
  if(modal.type==="editDebt") {const debt=modal.payload;return <DebtForm state={state} debt={debt} profileId={debt.profileId} onClose={close} onSave={data=>{setState(s=>({...s,debts:s.debts.map(x=>x.id===debt.id?normalizeDebtRecord({...x,...data}):x)}));close();}}/>;}
  if(modal.type==="debtInstallmentActions") {const {debtId,installmentNumber}=modal.payload;const debt=state.debts.find(x=>x.id===debtId);const inst=debt&&debtSchedule(state,debt).find(x=>num(x.number)===num(installmentNumber));if(!debt||!inst)return null;const payment=debtInstallmentPayment(state,debt.id,inst.number);return <DebtInstallmentActionsModal debt={debt} installment={inst} payment={payment} onClose={close} onPay={()=>setModal({type:"payDebtInstallment",payload:{debtId:debt.id,installmentNumber:inst.number}})} onRenegotiate={()=>setModal({type:"renegotiateDebtInstallment",payload:{debtId:debt.id,installmentNumber:inst.number}})}/>;}
  if(modal.type==="payDebtInstallment") {const {debtId,installmentNumber}=modal.payload;const debt=state.debts.find(x=>x.id===debtId);const inst=debt&&debtSchedule(state,debt).find(x=>num(x.number)===num(installmentNumber));if(!debt||!inst)return null;return <DebtInstallmentPaymentForm debt={debt} installment={inst} onClose={close} onSave={ev=>{setState(s=>({...s,debtEvents:[...s.debtEvents,{...ev,id:id("de"),debtId:debt.id}]}));close();}}/>;}
  if(modal.type==="renegotiateDebtInstallment") {const {debtId,installmentNumber}=modal.payload;const debt=state.debts.find(x=>x.id===debtId);const inst=debt&&debtSchedule(state,debt).find(x=>num(x.number)===num(installmentNumber));if(!debt||!inst)return null;return <DebtInstallmentEditForm debt={debt} installment={inst} onClose={close} onSave={(data,scope)=>{setState(s=>({...s,debts:s.debts.map(x=>x.id===debt.id?updateDebtInstallmentSchedule(s,x,inst.number,data,scope):x)}));close();}}/>;}
  if(modal.type==="amortizeDebt") {const debt=modal.payload;return <DebtAmortizationForm debt={debt} onClose={close} onSave={ev=>{setState(s=>{const current=s.debts.find(x=>x.id===debt.id);if(!current)return s;const event={...ev,id:id("de"),debtId:debt.id,kind:"amortization"};const updated=applyDebtAmortization(s,current,event);return {...s,debts:s.debts.map(x=>x.id===debt.id?updated:x),debtEvents:[...s.debtEvents,event]};});close();}}/>;}
  if(modal.type==="manageDebt") {const debt=modal.payload;const status=debtStatus(state,debt);return <ManageDebtModal debt={debt} status={status} onClose={close} onArchive={()=>{setState(s=>({...s,debts:s.debts.map(x=>x.id===debt.id?{...x,status:"archived"}:x)}));close();}} onReactivate={()=>{setState(s=>({...s,debts:s.debts.map(x=>x.id===debt.id?{...x,status:"active"}:x)}));close();}} onSettle={()=>{setState(s=>({...s,debts:s.debts.map(x=>x.id===debt.id?{...x,status:"settled"}:x)}));close();}} onDelete={()=>{if(!window.confirm(`Excluir “${debt.name}” e todos os pagamentos/amortizações ligados a ela? Esta ação é definitiva.`))return;setState(s=>({...s,debts:s.debts.filter(x=>x.id!==debt.id),debtEvents:s.debtEvents.filter(x=>x.debtId!==debt.id)}));close();}}/>;}
  if(modal.type==="newGoal") return <GoalForm profileId={profileId} onClose={close} onSave={data=>{setState(s=>({...s,goals:[...s.goals,{...data,id:id("goal"),profileId,current:0,createdAt:new Date().toISOString()}]}));close();}}/>;
  if(modal.type==="goalContribution") {const g=modal.payload;return <PaymentForm title={`Aporte • ${g.name}`} max={Math.max(0,num(g.target)-num(g.current))||999999999} onClose={close} onSave={p=>{setState(s=>({...s,goals:s.goals.map(x=>x.id===g.id?{...x,current:num(x.current)+num(p.amount)}:x)}));close();}} label="Valor do aporte"/>;}
  return null;
}

function EntryForm({title,kind,state,profileId,onClose,onSave}) {
