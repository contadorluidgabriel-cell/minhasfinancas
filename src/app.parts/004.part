    <div className="sidebar-copy sync-card" style={{position:"absolute",bottom:16,left:12,right:12,padding:"12px",borderRadius:14,background:`linear-gradient(145deg,${THEME.card},${THEME.panel})`,border:`1px solid ${THEME.border}`,boxShadow:THEME.softShadow}}><div style={{display:"flex",alignItems:"center",justifyContent:"space-between",gap:8}}><div style={{fontSize:9.5,fontWeight:850,color:THEME.muted,letterSpacing:.7}}>NUVEM</div><span style={{width:8,height:8,borderRadius:99,background:!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income,boxShadow:`0 0 0 4px ${(!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income)}12`}}/></div><div style={{fontSize:10.8,color:!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income,marginTop:6,fontWeight:750}}>{!isOnline?"Offline • cache local":syncStatus==="saving"?"Salvando na nuvem…":syncStatus==="error"?"Falha ao sincronizar":"Supabase sincronizado"}</div><div style={{fontSize:9,color:THEME.subtle,marginTop:4}}>{lastSyncedAt?`Última sincronização ${new Date(lastSyncedAt).toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"})}`:"Aguardando primeira sincronização"}</div></div>
  </aside>;
}

function Topbar({state,setState,tab,ym,setYm,viewMode,setViewMode,setSideOpen,search,setSearch,userEmail,onSignOut,syncStatus,lastSyncedAt,isOnline,onRetrySync}) {
  const active=state.activeProfileId;
  return <header className="topbar" style={{position:"sticky",top:0,zIndex:40,background:THEME.bg+"E8",backdropFilter:"blur(18px)",borderBottom:`1px solid ${THEME.border}`}}><div style={{height:72,padding:"0 22px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:14,maxWidth:1540,margin:"0 auto"}}>
    <div style={{display:"flex",alignItems:"center",gap:11,minWidth:0}}><button className="mobile-only topbar-menu" onClick={()=>setSideOpen(true)} style={{border:`1px solid ${THEME.border}`,background:THEME.card,color:THEME.text,borderRadius:10,padding:"8px 9px",cursor:"pointer"}}><Icon name="menu" size={17}/></button><div><div style={{fontSize:15,fontWeight:950,letterSpacing:-.25}}>{NAV.find(x=>x[0]===tab)?.[1]}</div><div style={{fontSize:9.9,color:THEME.subtle,marginTop:2}}>Organização financeira clara e objetiva</div></div></div>
    <div className="top-actions" style={{display:"flex",alignItems:"center",gap:8}}>
      <div className="search-wrap" style={{position:"relative"}}><span style={{position:"absolute",left:11,top:"50%",transform:"translateY(-50%)",color:THEME.subtle,pointerEvents:"none"}}><Icon name="search" size={15}/></span><Input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Buscar em tudo…" style={{width:205,padding:"8px 10px 8px 31px"}}/></div>
      <Select value={active} onChange={e=>setState(s=>({...s,activeProfileId:e.target.value}))} style={{width:155,padding:"8px 10px"}}><option value={PROFILE_ALL}>Consolidado</option>{state.profiles.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</Select>
      <div className="segmented" style={{display:"flex",border:`1px solid ${THEME.border}`,borderRadius:11,overflow:"hidden",background:THEME.input,padding:2}}><button onClick={()=>setViewMode("month")} style={{border:0,borderRadius:8,padding:"7px 10px",background:viewMode==="month"?THEME.accent+"25":"transparent",color:viewMode==="month"?THEME.text:THEME.muted,cursor:"pointer",fontSize:10.8,fontWeight:850}}>Mês</button><button onClick={()=>setViewMode("30d")} style={{border:0,borderRadius:8,padding:"7px 10px",background:viewMode==="30d"?THEME.accent+"25":"transparent",color:viewMode==="30d"?THEME.text:THEME.muted,cursor:"pointer",fontSize:10.8,fontWeight:850}}>30 dias</button></div>
      <Input type="month" value={ym} onChange={e=>setYm(e.target.value)} style={{width:135,padding:"8px 9px"}}/>
      <div className="sync-pill" title={lastSyncedAt?`Última sincronização: ${new Date(lastSyncedAt).toLocaleString("pt-BR")}`:userEmail||""} style={{display:"flex",alignItems:"center",gap:7,padding:"7px 9px",border:`1px solid ${!isOnline?THEME.warning+"55":syncStatus==="error"?THEME.expense+"55":THEME.border}`,borderRadius:11,background:THEME.card}}><span style={{width:7,height:7,borderRadius:99,background:!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income,boxShadow:`0 0 0 4px ${(!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income)}10`}}/><span style={{fontSize:9.8,color:THEME.muted,maxWidth:125,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{!isOnline?"Offline":syncStatus==="saving"?"Salvando…":syncStatus==="error"?"Erro ao salvar":lastSyncedAt?`Sincronizado ${new Date(lastSyncedAt).toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"})}`:"Sincronizado"}</span>{syncStatus==="error"&&isOnline&&<button onClick={onRetrySync} title="Tentar novamente" style={{border:0,background:"transparent",color:THEME.warning,cursor:"pointer",fontWeight:900}}>↻</button>}<button onClick={onSignOut} title={userEmail?`Sair de ${userEmail}`:"Sair"} style={{border:0,background:"transparent",color:THEME.subtle,cursor:"pointer",fontWeight:900}}>↪</button></div>
    </div>
  </div></header>;
}

function QuickAction({icon,label,tone="accent",onClick}) { const c=TONE(tone); return <button className="quick-action" onClick={onClick} style={{minWidth:0,border:`1px solid ${THEME.border}`,borderRadius:13,padding:"11px",background:`linear-gradient(145deg,${THEME.card2}E8,${THEME.panel})`,color:THEME.text,cursor:"pointer",textAlign:"left"}}><span style={{width:34,height:34,borderRadius:11,display:"grid",placeItems:"center",background:c+"12",border:`1px solid ${c}24`,color:c,marginBottom:9}}><Icon name={icon} size={17}/></span><span style={{display:"block",fontSize:10.4,fontWeight:820,lineHeight:1.3,color:THEME.text}}>{label}</span></button>; }
function QuickActions({openModal}) {
  return <div className="quick-actions" style={{display:"grid",gridTemplateColumns:"repeat(4,minmax(0,1fr))",gap:8}}><QuickAction icon="down" label="Recebimento" onClick={()=>openModal("newReceivable")}/><QuickAction icon="up" label="Nova conta" tone="warning" onClick={()=>openModal("newBill")}/><QuickAction icon="card" label="Compra no cartão" tone="cyan" onClick={()=>openModal("newCardPurchase")}/><QuickAction icon="check" label="Dar baixa" tone="income" onClick={()=>openModal("payBill")}/></div>;
}

function Dashboard({state,metrics,ym,viewMode,openModal,setTab}) {
  const active=state.activeProfileId;
  const upcoming=[];
  metrics.bills.forEach(x=>{if(remaining(x)>0) upcoming.push({id:x.id,type:"Conta",name:x.name,date:x.dueDate,value:remaining(x),status:statusFromItem(x),profileId:x.profileId});});
  metrics.receivables.forEach(x=>{if(remaining(x)>0) upcoming.push({id:x.id,type:"Receber",name:x.name,date:x.dueDate,value:remaining(x),status:statusFromItem(x),profileId:x.profileId,income:true});});
  state.cards.filter(x=>profileMatch(x,active)).forEach(card=>{
    const amount=cardStatementAmount(state,card.id,ym)-cardStatementPaid(state,card.id,ym); if(amount>0) upcoming.push({id:`card-${card.id}`,type:"Fatura",name:card.name,date:statementDueDate(card,ym),value:amount,profileId:card.profileId});
  });
  state.debts.filter(x=>profileMatch(x,active)&&debtStatus(state,x)==="active").forEach(debt=>{debtSchedule(state,debt).filter(inst=>inMonth(inst.dueDate,ym)&&!debtInstallmentPayment(state,debt.id,inst.number)).forEach(inst=>upcoming.push({id:`debt-${debt.id}-${inst.number}`,type:"Parcela",name:debt.name,date:inst.dueDate,value:inst.amount,profileId:debt.profileId}));});
  upcoming.sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  const recentReceived=metrics.receivables.filter(x=>paidTotal(x)>0).sort((a,b)=>String(b.dueDate).localeCompare(String(a.dueDate))).slice(0,5);
  return <div style={{display:"grid",gap:15}}>
    <div className="hero" style={{padding:"21px",borderRadius:20,border:`1px solid ${THEME.border}`,background:`radial-gradient(circle at 12% -20%,${THEME.accent}1B,transparent 40%),linear-gradient(145deg,${THEME.card},${THEME.panel})`,boxShadow:THEME.softShadow,overflow:"hidden"}}>
      <div className="hero-layout" style={{display:"grid",gridTemplateColumns:"minmax(0,1.32fr) minmax(400px,.68fr)",gap:18,alignItems:"stretch"}}>
        <div className="hero-metrics" style={{display:"grid",gridTemplateColumns:"1.12fr 1fr",gap:0,minWidth:0}}>
          <div className="hero-metric" style={{padding:"7px 22px 7px 3px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:14,borderRight:`1px solid ${THEME.border}`}}>
            <div><div style={{fontSize:9.5,color:THEME.muted,textTransform:"uppercase",letterSpacing:1,fontWeight:820}}>{viewMode==="month"?`Saldo projetado • ${monthName(ym)}`:"Saldo projetado • próximos 30 dias"}</div><div style={{fontSize:35,fontWeight:930,marginTop:8,letterSpacing:-1.15,color:metrics.balanceProjected>=0?THEME.text:THEME.expense,fontVariantNumeric:"tabular-nums"}}>{money(metrics.balanceProjected)}</div><div style={{fontSize:10.5,color:THEME.subtle,marginTop:6,lineHeight:1.4}}>Saldo atual + a receber − compromissos pendentes</div></div>
            <Sparkline tone={metrics.balanceProjected>=0?"accent":"expense"}/>
          </div>
          <div className="hero-metric" style={{padding:"7px 20px 7px 24px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:12}}>
            <div><div style={{fontSize:9.5,color:THEME.muted,textTransform:"uppercase",letterSpacing:1,fontWeight:820}}>Resultado projetado</div><div style={{fontSize:28,fontWeight:930,marginTop:10,letterSpacing:-.7,color:metrics.resultProjected>=0?THEME.accent:THEME.expense,fontVariantNumeric:"tabular-nums"}}>{money(metrics.resultProjected)}</div><div style={{fontSize:10.5,color:THEME.subtle,marginTop:6,lineHeight:1.4}}>Receitas do período − compromissos do período</div></div>
            <Sparkline tone={metrics.resultProjected>=0?"accent":"expense"}/>
          </div>
        </div>
        <QuickActions openModal={openModal}/>
      </div>
    </div>
    <div className="kpi-grid kpi-grid-six"><Kpi icon="down" label="Recebido" value={money(metrics.received)} sub="Já entrou no período" tone="income"/><Kpi icon="receivables" label="A receber" value={money(metrics.toReceive)} sub="Ainda previsto" tone="income"/><Kpi icon="up" label="Pago" value={money(metrics.paid)} sub="Já saiu no período" tone="expense"/><Kpi icon="bills" label="A pagar" value={money(metrics.toPay)} sub="Contas + faturas + parcelas" tone="expense"/><Kpi icon="card" label="Faturas abertas" value={money(metrics.cardOpen)} sub="Cartões no período" tone="cyan"/><Kpi icon="wallet" label="Saldo atual" value={money(metrics.balanceCurrent)} sub="Fotografia bancária informada" tone="cyan"/></div>
    <div className="dash-columns">
      <Card><SectionHeader title="Próximos compromissos" sub="Contas, faturas, parcelas e recebimentos na mesma linha do tempo" action={<Button ghost onClick={()=>setTab("calendar")}>Ver calendário</Button>}/><div style={{overflowX:"auto"}}>{upcoming.length===0?<Empty>Nenhum compromisso neste período.</Empty>:<table className="table"><thead><tr><th>Tipo</th><th>Descrição</th><th>Data</th><th>Perfil</th><th style={{textAlign:"right"}}>Valor</th><th>Status</th></tr></thead><tbody>{upcoming.slice(0,10).map(x=>{const u=urgency(x.date);return <tr key={x.id}><td><Badge tone={x.income?"income":x.type==="Fatura"?"cyan":x.type==="Parcela"?"warning":"muted"}>{x.type}</Badge></td><td><b>{x.name}</b></td><td>{new Date(`${x.date}T12:00:00`).toLocaleDateString("pt-BR")}</td><td style={{color:THEME.muted}}>{profileName(state,x.profileId)}</td><td style={{textAlign:"right",fontWeight:850,color:x.income?THEME.income:THEME.text}}>{money(x.value)}</td><td><Badge tone={u.tone}>{u.label}</Badge></td></tr>})}</tbody></table>}</div></Card>
      <div style={{display:"grid",gap:14}}>
        <Card><SectionHeader title="Faturas abertas" sub="Compras do cartão viram fatura automaticamente" action={<Button ghost onClick={()=>setTab("cards")}>Cartões</Button>}/><CardBody style={{display:"grid",gap:10}}>{state.cards.filter(x=>profileMatch(x,active)).length===0?<Empty>Nenhum cartão cadastrado.</Empty>:state.cards.filter(x=>profileMatch(x,active)).map(card=>{const total=cardStatementAmount(state,card.id,ym);const paid=cardStatementPaid(state,card.id,ym);const open=Math.max(0,total-paid);return <div key={card.id} style={{padding:12,borderRadius:13,background:THEME.card2,border:`1px solid ${THEME.border}`}}><div style={{display:"flex",justifyContent:"space-between",gap:8}}><div><div style={{fontSize:12,fontWeight:900}}>{card.name}</div><div style={{fontSize:10,color:THEME.muted,marginTop:3}}>Vence dia {card.dueDay}</div></div><div style={{textAlign:"right"}}><div style={{fontSize:14,fontWeight:950,color:open>0?THEME.cyan:THEME.income}}>{money(open)}</div><div style={{fontSize:9.5,color:THEME.subtle}}>aberto</div></div></div></div>})}</CardBody></Card>
