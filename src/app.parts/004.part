    <nav style={{display:"grid",gap:3}}>{NAV.map(([key,label,icon])=><button key={key} onClick={()=>{setTab(key);setOpen(false)}} style={{display:"flex",alignItems:"center",gap:10,width:"100%",border:0,borderRadius:11,padding:"10px 10px",background:tab===key?THEME.accent+"18":"transparent",color:tab===key?THEME.text:THEME.muted,cursor:"pointer",fontSize:12,fontWeight:tab===key?850:650,textAlign:"left"}}><span style={{width:18,textAlign:"center",color:tab===key?THEME.accent:THEME.subtle}}>{icon}</span><span className="sidebar-copy">{label}</span></button>)}</nav>
    <div className="sidebar-copy" style={{position:"absolute",bottom:16,left:12,right:12,padding:"10px 11px",borderRadius:12,background:THEME.card,border:`1px solid ${THEME.border}`}}><div style={{fontSize:10,fontWeight:850,color:THEME.muted}}>ARMAZENAMENTO</div><div style={{fontSize:11,color:!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income,marginTop:3}}>{!isOnline?"Offline • salvo neste dispositivo":syncStatus==="saving"?"Salvando na nuvem…":syncStatus==="error"?"Falha ao sincronizar":"Supabase • sincronizado"}</div><div style={{fontSize:9,color:THEME.subtle,marginTop:3}}>{lastSyncedAt?`Última nuvem: ${new Date(lastSyncedAt).toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"})}`:"Aguardando primeira sincronização"}</div></div>
  </aside>;
}

function Topbar({state,setState,tab,ym,setYm,viewMode,setViewMode,setSideOpen,search,setSearch,userEmail,onSignOut,syncStatus,lastSyncedAt,isOnline,onRetrySync}) {
  const active=state.activeProfileId;
  return <header style={{position:"sticky",top:0,zIndex:40,background:THEME.bg+"EB",backdropFilter:"blur(16px)",borderBottom:`1px solid ${THEME.border}`}}><div style={{height:66,padding:"0 20px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:12,maxWidth:1500,margin:"0 auto"}}>
    <div style={{display:"flex",alignItems:"center",gap:10,minWidth:0}}><button className="mobile-only" onClick={()=>setSideOpen(true)} style={{border:`1px solid ${THEME.border}`,background:THEME.card,color:THEME.text,borderRadius:9,padding:"7px 9px",cursor:"pointer"}}>☰</button><div><div style={{fontSize:14,fontWeight:950}}>{NAV.find(x=>x[0]===tab)?.[1]}</div><div style={{fontSize:10,color:THEME.subtle}}>Organização financeira, sem microcontrole inútil</div></div></div>
    <div className="top-actions" style={{display:"flex",alignItems:"center",gap:8}}>
      <Input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Buscar em tudo…" style={{width:190,padding:"8px 10px"}}/>
      <Select value={active} onChange={e=>setState(s=>({...s,activeProfileId:e.target.value}))} style={{width:150,padding:"8px 10px"}}><option value={PROFILE_ALL}>Consolidado</option>{state.profiles.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</Select>
      <div style={{display:"flex",border:`1px solid ${THEME.border}`,borderRadius:10,overflow:"hidden"}}><button onClick={()=>setViewMode("month")} style={{border:0,padding:"8px 10px",background:viewMode==="month"?THEME.accent+"22":"transparent",color:viewMode==="month"?THEME.text:THEME.muted,cursor:"pointer",fontSize:11,fontWeight:800}}>Mês</button><button onClick={()=>setViewMode("30d")} style={{border:0,padding:"8px 10px",background:viewMode==="30d"?THEME.accent+"22":"transparent",color:viewMode==="30d"?THEME.text:THEME.muted,cursor:"pointer",fontSize:11,fontWeight:800}}>30 dias</button></div>
      <Input type="month" value={ym} onChange={e=>setYm(e.target.value)} style={{width:132,padding:"8px 9px"}}/>
      <div title={lastSyncedAt?`Última sincronização: ${new Date(lastSyncedAt).toLocaleString("pt-BR")}`:userEmail||""} style={{display:"flex",alignItems:"center",gap:7,padding:"6px 8px",border:`1px solid ${!isOnline?THEME.warning+"66":syncStatus==="error"?THEME.expense+"66":THEME.border}`,borderRadius:10,background:THEME.card}}><span style={{width:7,height:7,borderRadius:99,background:!isOnline?THEME.warning:syncStatus==="error"?THEME.expense:syncStatus==="saving"?THEME.warning:THEME.income}}/><span style={{fontSize:10,color:THEME.muted,maxWidth:130,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{!isOnline?"Offline":syncStatus==="saving"?"Salvando…":syncStatus==="error"?"Erro ao salvar":lastSyncedAt?`Sincronizado ${new Date(lastSyncedAt).toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"})}`:"Sincronizado"}</span>{syncStatus==="error"&&isOnline&&<button onClick={onRetrySync} title="Tentar novamente" style={{border:0,background:"transparent",color:THEME.warning,cursor:"pointer",fontWeight:900}}>↻</button>}<button onClick={onSignOut} title={userEmail?`Sair de ${userEmail}`:"Sair"} style={{border:0,background:"transparent",color:THEME.subtle,cursor:"pointer",fontWeight:900}}>↪</button></div>
    </div>
  </div></header>;
}

function QuickActions({openModal}) {
  return <div style={{display:"flex",gap:8,flexWrap:"wrap"}}><Button onClick={()=>openModal("newReceivable")}>+ Recebimento</Button><Button onClick={()=>openModal("newBill")} tone="warning">+ Conta</Button><Button onClick={()=>openModal("newCardPurchase")} tone="cyan">+ Compra no cartão</Button><Button onClick={()=>openModal("payBill")} tone="income" ghost>Dar baixa em conta</Button></div>;
}

function Dashboard({state,metrics,ym,viewMode,openModal,setTab}) {
  const active=state.activeProfileId;
  const upcoming=[];
  metrics.bills.forEach(x=>{if(remaining(x)>0) upcoming.push({id:x.id,type:"Conta",name:x.name,date:x.dueDate,value:remaining(x),status:statusFromItem(x),profileId:x.profileId});});
  metrics.receivables.forEach(x=>{if(remaining(x)>0) upcoming.push({id:x.id,type:"Receber",name:x.name,date:x.dueDate,value:remaining(x),status:statusFromItem(x),profileId:x.profileId,income:true});});
  state.cards.filter(x=>profileMatch(x,active)).forEach(card=>{
    const amount=cardStatementAmount(state,card.id,ym)-cardStatementPaid(state,card.id,ym); if(amount>0) upcoming.push({id:`card-${card.id}`,type:"Fatura",name:card.name,date:statementDueDate(card,ym),value:amount,profileId:card.profileId});
  });
  state.debts.filter(x=>profileMatch(x,active)&&debtStatus(state,x)==="active").forEach(debt=>{debtSchedule(state,debt).filter(inst=>inMonth(inst.dueDate,ym)&&!debtInstallmentPayment(state,debt.id,inst.number)).forEach(inst=>upcoming.push({id:`debt-${debt.id}-${inst.number}`,type:"Parcela",name:debt.name,date:inst.dueDate,value:inst.amount,profileId:debt.profileId}));});
  upcoming.sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  const recentReceived=metrics.receivables.filter(x=>paidTotal(x)>0).sort((a,b)=>String(b.dueDate).localeCompare(String(a.dueDate))).slice(0,5);
  return <div style={{display:"grid",gap:14}}>
    <div className="hero" style={{padding:"22px 22px",borderRadius:20,border:`1px solid ${THEME.border}`,background:`radial-gradient(circle at 88% 12%,${THEME.accent}1F,transparent 25%),linear-gradient(145deg,${THEME.card},${THEME.panel})`}}><div style={{display:"flex",justifyContent:"space-between",gap:20,alignItems:"flex-start",flexWrap:"wrap"}}><div style={{display:"flex",gap:30,flexWrap:"wrap"}}><div><div style={{fontSize:10,color:THEME.muted,textTransform:"uppercase",letterSpacing:1,fontWeight:850}}>{viewMode==="month"?`Saldo projetado • ${monthName(ym)}`:"Saldo projetado • próximos 30 dias"}</div><div style={{fontSize:31,fontWeight:950,marginTop:6,color:metrics.balanceProjected>=0?THEME.text:THEME.expense}}>{money(metrics.balanceProjected)}</div><div style={{fontSize:11,color:THEME.muted,marginTop:5}}>Saldo atual + a receber − compromissos pendentes</div></div><div style={{paddingLeft:22,borderLeft:`1px solid ${THEME.border}`}}><div style={{fontSize:10,color:THEME.muted,textTransform:"uppercase",letterSpacing:1,fontWeight:850}}>Resultado projetado</div><div style={{fontSize:25,fontWeight:950,marginTop:7,color:metrics.resultProjected>=0?THEME.accent:THEME.expense}}>{money(metrics.resultProjected)}</div><div style={{fontSize:11,color:THEME.muted,marginTop:5}}>Receitas do período − compromissos do período</div></div></div><QuickActions openModal={openModal}/></div></div>
    <div className="kpi-grid kpi-grid-six"><Kpi label="Recebido" value={money(metrics.received)} sub="Já entrou no período" tone="income"/><Kpi label="A receber" value={money(metrics.toReceive)} sub="Ainda previsto" tone="income"/><Kpi label="Pago" value={money(metrics.paid)} sub="Já saiu no período" tone="expense"/><Kpi label="A pagar" value={money(metrics.toPay)} sub="Contas + faturas + parcelas" tone="expense"/><Kpi label="Faturas abertas" value={money(metrics.cardOpen)} sub="Cartões no período" tone="cyan"/><Kpi label="Saldo atual" value={money(metrics.balanceCurrent)} sub="Fotografia bancária informada" tone="cyan"/></div>
    <div className="dash-columns">
      <Card><SectionHeader title="Próximos compromissos" sub="Contas, faturas, parcelas e recebimentos na mesma linha do tempo" action={<Button ghost onClick={()=>setTab("calendar")}>Ver calendário</Button>}/><div style={{overflowX:"auto"}}>{upcoming.length===0?<Empty>Nenhum compromisso neste período.</Empty>:<table className="table"><thead><tr><th>Tipo</th><th>Descrição</th><th>Data</th><th>Perfil</th><th style={{textAlign:"right"}}>Valor</th><th>Status</th></tr></thead><tbody>{upcoming.slice(0,10).map(x=>{const u=urgency(x.date);return <tr key={x.id}><td><Badge tone={x.income?"income":x.type==="Fatura"?"cyan":x.type==="Parcela"?"warning":"muted"}>{x.type}</Badge></td><td><b>{x.name}</b></td><td>{new Date(`${x.date}T12:00:00`).toLocaleDateString("pt-BR")}</td><td style={{color:THEME.muted}}>{profileName(state,x.profileId)}</td><td style={{textAlign:"right",fontWeight:850,color:x.income?THEME.income:THEME.text}}>{money(x.value)}</td><td><Badge tone={u.tone}>{u.label}</Badge></td></tr>})}</tbody></table>}</div></Card>
      <div style={{display:"grid",gap:14}}>
        <Card><SectionHeader title="Faturas abertas" sub="Compras do cartão viram fatura automaticamente" action={<Button ghost onClick={()=>setTab("cards")}>Cartões</Button>}/><CardBody style={{display:"grid",gap:10}}>{state.cards.filter(x=>profileMatch(x,active)).length===0?<Empty>Nenhum cartão cadastrado.</Empty>:state.cards.filter(x=>profileMatch(x,active)).map(card=>{const total=cardStatementAmount(state,card.id,ym);const paid=cardStatementPaid(state,card.id,ym);const open=Math.max(0,total-paid);return <div key={card.id} style={{padding:12,borderRadius:13,background:THEME.card2,border:`1px solid ${THEME.border}`}}><div style={{display:"flex",justifyContent:"space-between",gap:8}}><div><div style={{fontSize:12,fontWeight:900}}>{card.name}</div><div style={{fontSize:10,color:THEME.muted,marginTop:3}}>Vence dia {card.dueDay}</div></div><div style={{textAlign:"right"}}><div style={{fontSize:14,fontWeight:950,color:open>0?THEME.cyan:THEME.income}}>{money(open)}</div><div style={{fontSize:9.5,color:THEME.subtle}}>aberto</div></div></div></div>})}</CardBody></Card>
